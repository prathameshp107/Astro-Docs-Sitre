{
  "id": "30-day-dsa-bootcamp",
  "title": "30-Day DSA Bootcamp",
  "tagline": "From absolute beginner to confidently solving medium problems — notes, visualizers, and judged problems daily.",
  "difficulty": "beginner",
  "durationDays": 30,
  "hoursPerDay": 2,
  "tags": ["dsa", "beginners", "bootcamp"],
