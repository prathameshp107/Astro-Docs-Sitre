---
/**
 * GoogleAnalytics.astro — site-wide analytics loader (GA4 + Vercel).
 * ────────────────────────────────────────────────────────────────
 * Despite the filename this now loads BOTH GA4 and Vercel Web Analytics.
 * It is the single component every page reaches — PageSEO (40 standalone
 * pages), SEOHead (all Starlight docs) and 26 hand-rolled heads all import
 * it — so it is the one place that guarantees site-wide coverage.
 *
 * Vercel's <Analytics /> sits OUTSIDE the gaId gate on purpose: the two are
 * independent, and a missing GA id must not silently disable Vercel too.
 * It self-disables off-Vercel, so local dev is unaffected.
 *
 * Drop this into any page's <head>. The GA half renders nothing if
 * PUBLIC_GA_MEASUREMENT_ID isn't set, so local dev / forks without
 * an ID work normally.
 *
 * Page views are sent manually via a `page_view` event (send_page_view:
 * false) instead of gtag's automatic one-shot pageview, because several
 * pages on this site (Starlight docs) navigate via Astro's client router
 * without a full reload. `astro:page-load` fires on both the initial
 * load and every subsequent client-side navigation, and the
 * lastTrackedPath guard prevents it from double-counting the initial
 * page when it also fires there.
 */
import Analytics from '@vercel/analytics/astro';

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!-- Vercel Web Analytics. Same-origin (/_vercel/insights/*), so the
     existing CSP `script-src 'self'` / `connect-src 'self'` already
     permit it — no vercel.json change needed. -->
<Analytics />

{gaId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId, { send_page_view: false });

      let lastTrackedPath = null;
      function trackPageView() {
        if (lastTrackedPath === location.pathname) return;
        lastTrackedPath = location.pathname;
        gtag('event', 'page_view', {
          page_location: location.href,
          page_path: location.pathname,
          page_title: document.title,
        });
      }

      trackPageView();
      document.addEventListener('astro:page-load', trackPageView);
    </script>
  </>
)}
