---
/**
 * GoogleAnalytics.astro — site-wide GA4 (Google tag) loader.
 * ────────────────────────────────────────────────────────────────
 * Drop this into any page's <head>. Renders nothing if
 * PUBLIC_GA_MEASUREMENT_ID isn't set, so local dev / forks without
 * an ID work normally.
 *
 * Page views are sent manually via a `page_view` event (send_page_view:
 * false) instead of gtag's automatic one-shot pageview, because several
 * pages on this site (Starlight docs) navigate via Astro's client router
 * without a full reload. `astro:page-load` fires on both the initial
 * load and every subsequent client-side navigation, and the
 * lastTrackedPath guard prevents it from double-counting the initial
 * page when it also fires there.
 */
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

{gaId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId, { send_page_view: false });

      let lastTrackedPath = null;
      function trackPageView() {
        if (lastTrackedPath === location.pathname) return;
        lastTrackedPath = location.pathname;
        gtag('event', 'page_view', {
          page_location: location.href,
          page_path: location.pathname,
          page_title: document.title,
        });
      }

      trackPageView();
      document.addEventListener('astro:page-load', trackPageView);
    </script>
  </>
)}
