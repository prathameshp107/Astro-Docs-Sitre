---
import AppNav from '../../components/AppNav.jsx';
import CompanyDirectory from '../../components/companies/CompanyDirectory.jsx';
import PageSEO from '../../components/PageSEO.astro';
import '../../styles/mcq-tailwind.css';
import '../../styles/landing.css';
import '../../styles/companies.css';
import '../../styles/sketch-visualizer.css';

const SITE_URL = 'https://interviewpreprationbuddy.in';
const PAGE_URL = `${SITE_URL}/companies`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Company-Specific Interview Preparation Tracks',
  description: 'Curated interview preparation tracks for Google, Amazon, Meta, Microsoft, Apple, TCS, Infosys, and other top tech companies.',
  url: PAGE_URL,
  image: `${SITE_URL}/assets/og-image.png`,
  numberOfItems: 10,
  author: { '@id': `${SITE_URL}/#author` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  isPartOf: { '@type': 'WebSite', '@id': `${SITE_URL}/#website` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How do I prepare for a Google software engineering interview?',
      acceptedAnswer: { '@type': 'Answer', text: 'Google interviews focus on algorithmic coding (hard LeetCode level), system design (for senior roles), and behavioral questions. Key preparation: master graph algorithms, dynamic programming, and tree problems. Practice explaining your thought process clearly. Google uses a collaborative coding format — think aloud, clarify the problem, and discuss time/space complexity.' },
    },
    {
      '@type': 'Question',
      name: 'How do I prepare for an Amazon SDE interview?',
      acceptedAnswer: { '@type': 'Answer', text: 'Amazon SDE interviews include 2-4 coding rounds (medium-hard DSA), 1-2 system design rounds (for SDE-2+), and Leadership Principle behavioral rounds in every interview. Key tip: prepare 5-6 strong STAR stories that cover multiple leadership principles. Study distributed systems, DynamoDB, SQS, and microservices patterns.' },
    },
    {
      '@type': 'Question',
      name: 'What companies are covered in Interview Prep Buddy?',
      acceptedAnswer: { '@type': 'Answer', text: 'Interview Prep Buddy provides company-specific interview tracks for: Google, Amazon, Meta (Facebook), Microsoft, Apple, Netflix, Flipkart, Uber, Airbnb, TCS, Infosys, Wipro, and other top product and services companies. Each track includes curated DSA problems, system design topics, and behavioral question sets.' },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="Company Interview Tracks — Google, Amazon, Meta, Microsoft Prep | Interview Prep Buddy"
      description="Targeted interview preparation tracks for Google, Amazon, Meta, Microsoft, Apple, and top tech companies. Round-by-round study pipelines, curated DSA problems, behavioral LP questions, and prep timelines."
      url={PAGE_URL}
      keywords="Google interview preparation, Amazon SDE interview, Meta interview prep, Microsoft interview, FAANG interview guide, company specific interview, tech company interview track, software engineer interview"
      schema={schema}
      faqSchema={faqSchema}
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Company Tracks', url: '/companies' }]}
    />
  </head>
  <body class="mcq-body font-sketch">
    <div style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;" aria-hidden="true">
      <h1>Company-Specific Interview Tracks — Google, Amazon, Meta, Microsoft and More</h1>
      <p>Prepare for technical interviews at top tech companies with curated study tracks. Each company track includes the interview process overview, recommended DSA problems, system design topics, and behavioral questions specific to that company's culture.</p>
    </div>
    <AppNav activeSection="companies" client:load />
    <div class="max-w-6xl mx-auto px-4 py-8">
      <header class="sketch-border bg-[var(--sketch-bg-dim)] p-8 md:p-10 rounded-3xl text-center mb-10 border-2 border-[var(--sketch-border)] shadow-2xl relative font-sketch">
        <div class="inline-block sketch-border-soft px-4 py-1.5 text-xs font-mono font-bold bg-amber-500/20 text-amber-500 border-amber-500/40 rounded-full mb-4">
          🏢 TARGETED RECRUITER TRACKS
        </div>
        <h1 class="font-header font-bold text-4xl md:text-5xl text-[var(--sketch-text)] mb-4">
          Company Interview Tracks
        </h1>
        <p class="text-[var(--sketch-text-muted)] text-base md:text-lg max-w-2xl mx-auto leading-relaxed font-sketch">
          Targeted study pipelines mapped out round-by-round. Curated problem sets, behavioral LPs, and interactive prep plans.
        </p>
      </header>
      <CompanyDirectory client:load />
    </div>
  </body>
</html>
