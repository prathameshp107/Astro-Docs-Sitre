---
import AppNav from '../../components/AppNav.jsx';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import ProcessMap from '../../components/companies/ProcessMap.jsx';
import CompanyProblemList from '../../components/companies/CompanyProblemList.jsx';
import PlanDetail from '../../components/plans/PlanDetail.jsx';
import { getPlans } from '../../data/plans/index.js';
import { getJudgeManifest } from '../../data/judge/index.js';
import { CASE_STUDIES } from '../../data/system-design/caseStudies.js';

import '../../styles/mcq-tailwind.css';
import '../../styles/landing.css';
import '../../styles/judge.css';
import '../../styles/plans.css';
import '../../styles/companies.css';
import '../../styles/sketch-visualizer.css';

export async function getStaticPaths() {
  const companies = import.meta.glob<{ default: any }>("../../data/companies/*.json", { eager: true });
  return Object.values(companies).map((module) => {
    const company = module.default ?? module;
    return {
      params: { slug: company.id },
      props: { company },
    };
  });
}

const { company } = Astro.props;

// Load interactive components dependencies
const plans = getPlans();
const plan = plans.find((p) => p.id === company.planRef);
const problems = getJudgeManifest();

// Cross-link relevant system-design case studies whose `companies` tag
// mentions this company (e.g. Amazon -> distributed-key-value-store via
// "Amazon DynamoDB") — substring match since tags aren't always exact names.
const relevantCaseStudies = CASE_STUDIES.filter((c) =>
  (c.companies || []).some((co) => co.toLowerCase().includes(company.name.toLowerCase()))
).slice(0, 5);

const lastVerifiedDate = new Date().toLocaleDateString("en-US", {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const companyColor = company.id === 'amazon' ? '#ff9900' : company.id === 'google' ? '#4285f4' : 'var(--accent)';
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");

// JSON-LD FAQ Page Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How many rounds are in the ${company.name} interview?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": company.id === "amazon" 
          ? "Amazon usually has 1 online assessment, 1 phone screen, and a final onsite loop of 4-5 rounds covering coding, system design, and behavioral Leadership Principles." 
          : "Google typically has 1 technical phone screen followed by an onsite loop of 4-5 rounds focusing on complex coding, system design, and Googlyness behavioral fit."
      }
    },
    {
      "@type": "Question",
      "name": `How hard is the ${company.name} interview?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The ${company.name} interview is rated as a ${company.difficulty}/5 in difficulty. It requires deep algorithmic expertise, scalability design capacity, and strong behavioral alignment.`
      }
    },
    {
      "@type": "Question",
      "name": `What coding topics are most frequent at ${company.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": company.id === "amazon" 
          ? "Focus heavily on Trees, Graphs, Heaps, Priority Queues, and Dynamic Programming." 
          : "Focus on sliding window string search, graph traversal paths, binary search boundaries, and mathematical complexities."
      }
    },
    {
      "@type": "Question",
      "name": `How do I prepare for ${company.name} behavioral rounds?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": company.id === "amazon" 
          ? "Prepare 8-10 stories in the STAR format mapped to Amazon's 16 Leadership Principles." 
          : "Focus on General Cognitive Ability (GCA) scenarios, handling team conflicts, navigating ambiguity, and showing humble leadership."
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <GoogleAnalytics />
    <script>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{company.name} SDE Interview Process & Questions — Free Prep Track</title>
    <meta name="description" content={`Prepare for the ${company.name} SDE interview. Detailed process map, distinctives, curated frequency coding questions, and a free SDE study plan.`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body class="mcq-body font-sketch">
    <AppNav activeSection="companies" client:load />

    <div class="company-track-layout max-w-6xl mx-auto px-4 py-8" style={`--company-accent: ${companyColor}; --company-accent-tint: ${companyColor}15;`}>
      {/* Chalkboard Hero Section */}
      <section class="sketch-border bg-[var(--sketch-bg-dim)] p-8 md:p-10 rounded-3xl mb-10 border-2 border-[var(--sketch-border)] shadow-2xl relative font-sketch">
        <a
          href={`${base}companies`}
          class="inline-flex items-center gap-2 sketch-button text-xs font-bold text-[var(--sketch-text-muted)] hover:text-amber-500 mb-6"
        >
          ← Back to All Companies
        </a>

        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <span class="sketch-border-soft px-3 py-1 text-xs font-mono font-bold bg-amber-500/20 text-amber-400 border-amber-500/40 rounded-full uppercase">
                {company.type}
              </span>
              <span class="text-xs font-mono text-emerald-400 font-bold">
                ✓ Verified: {lastVerifiedDate}
              </span>
            </div>
            <h1 class="font-header font-bold text-4xl md:text-5xl text-[var(--sketch-text)] mb-3">
              {company.name} Interview Track
            </h1>
            <p class="text-[var(--sketch-text-muted)] text-base max-w-2xl leading-relaxed font-sketch">
              A targeted preparation track for {company.name} SWE/SDE positions. Follow the interactive plan, review process rounds, and practice active problem-sets.
            </p>
          </div>

          <div class="sketch-panel-box sketch-border p-6 text-center min-w-[200px] bg-[var(--sketch-bg)]">
            <span class="text-xs font-mono text-[var(--sketch-text-muted)] uppercase tracking-wider block mb-2">Difficulty</span>
            <div class="flex items-center justify-center gap-1.5 mb-4">
              {Array.from({ length: 5 }).map((_, idx) => (
                <span
                  class="w-4 h-4 rounded-full border border-[var(--sketch-border)]"
                  style={{ 
                    backgroundColor: idx < company.difficulty ? companyColor : 'transparent'
                  }}
                />
              ))}
            </div>
            <span class="text-xs font-mono text-[var(--sketch-text-muted)] uppercase tracking-wider block mb-1">Target Regions</span>
            <span class="font-header text-lg font-bold text-amber-500">{company.region.map((r: string) => r.toUpperCase()).join(", ")}</span>
          </div>
        </div>
      </section>

      {/* Main Grid Content */}
      <div class="company-track-grid">
        {/* Left Column: Process & Problems */}
        <div class="track-main-col space-y-8">
          {/* Section: Process Map */}
          <div class="track-section sketch-border bg-[var(--sketch-bg-dim)] p-6 md:p-8 rounded-3xl border-2 border-[var(--sketch-border)] shadow-xl">
            <h2 class="font-header font-bold text-2xl text-[var(--sketch-text)] mb-1">Interview Process Map</h2>
            <p class="text-[var(--sketch-text-muted)] text-sm mb-6 font-sketch">Click on each round to check duration, focus items, and pro interview tips.</p>
            <ProcessMap rounds={company.rounds} companyId={company.id} client:load />
          </div>

          {/* Section: Distinctives */}
          <div class="track-section sketch-border bg-[var(--sketch-bg-dim)] p-6 md:p-8 rounded-3xl border-2 border-[var(--sketch-border)] shadow-xl">
            <h2 class="font-header font-bold text-2xl text-[var(--sketch-text)] mb-4">What's Different Here</h2>
            <div class="distinctives-list space-y-3">
              {company.distinctives.map((d: string) => (
                <div class="distinctive-item flex items-start gap-3">
                  <span class="text-amber-500 font-bold text-lg">✦</span>
                  <p class="text-[var(--sketch-text)] text-base font-sketch leading-relaxed">{d}</p>
                </div>
              ))}
            </div>
          </div>

          {/* Section: Coding Problems */}
          <div class="track-section sketch-border bg-[var(--sketch-bg-dim)] p-6 md:p-8 rounded-3xl border-2 border-[var(--sketch-border)] shadow-xl">
            <h2 class="font-header font-bold text-2xl text-[var(--sketch-text)] mb-1">Curated Problem Set</h2>
            <p class="text-[var(--sketch-text-muted)] text-sm mb-6 font-sketch">DSA questions reported in {company.name} interviews, ordered by frequency.</p>
            <CompanyProblemList
              problems={problems}
              companyId={company.id}
              problemFrequency={company.problemFrequency}
              client:only="react"
            />
          </div>

          {/* Section: Relevant System Design Case Studies */}
          {relevantCaseStudies.length > 0 && (
            <div class="track-section sketch-border bg-[var(--sketch-bg-dim)] p-6 md:p-8 rounded-3xl border-2 border-[var(--sketch-border)] shadow-xl">
              <h2 class="font-header font-bold text-2xl text-[var(--sketch-text)] mb-1">🏗️ Relevant System Design Case Studies</h2>
              <p class="text-[var(--sketch-text-muted)] text-sm mb-6 font-sketch">Architecture patterns associated with {company.name} — practice designing these before your interview.</p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {relevantCaseStudies.map((c) => (
                  <a
                    href={c.interactive ? `${base}system-design/case/${c.slug}` : `${base}system-design/11-case-studies/design-${c.slug}`}
                    class="sketch-panel-box sketch-border p-4 rounded-2xl bg-[var(--sketch-bg)] border border-[var(--sketch-border)] hover:border-amber-500 transition-all"
                  >
                    <div class="font-bold text-sm text-[var(--sketch-text)] mb-1">{c.title}</div>
                    <div class="text-xs text-[var(--sketch-text-muted)] leading-relaxed">{c.desc}</div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* Right Column: Study Plan & Behavioral */}
        <div class="track-sidebar-col space-y-8">
          {/* Embedded Study Plan */}
          {plan && (
            <div class="sidebar-section sketch-border bg-[var(--sketch-bg-dim)] p-6 rounded-3xl border-2 border-[var(--sketch-border)] shadow-xl">
              <h2 class="font-header font-bold text-2xl text-[var(--sketch-text)] mb-1">Curated Study Plan</h2>
              <p class="text-[var(--sketch-text-muted)] text-sm mb-4 font-sketch">Step-by-step prep track on our planning engine.</p>
              <div style="margin-top: 1rem;">
                <PlanDetail plan={plan} allPlans={plans} client:only="react" />
              </div>
            </div>
          )}

          {/* Behavioral Fit */}
          <div class="sidebar-section behavioral-card sketch-border bg-[var(--sketch-bg-dim)] p-6 rounded-3xl border-2 border-[var(--sketch-border)] shadow-xl">
            <h3 class="font-header font-bold text-xl text-amber-500 mb-2">Behavioral Alignment</h3>
            <p class="text-[var(--sketch-text-muted)] text-sm leading-relaxed mb-4 font-sketch">
              {company.id === 'amazon' 
                ? "Amazon places exceptional weight on leadership principles. Prepare your STAR stories beforehand." 
                : "Google evaluates structural general cognitive ability. Practice handling complexity and ambiguities."}
            </p>
            <a href="/DSA-Notes-Problems/behavioral" class="sketch-button inline-flex items-center gap-2 text-xs font-bold text-amber-500 border-amber-500/60 bg-amber-500/10 hover:bg-amber-500/20">
              Go to Behavioral Prep →
            </a>
          </div>

          {/* Levels & Career Grid */}
          <div class="sidebar-section levels-card sketch-border bg-[var(--sketch-bg-dim)] p-6 rounded-3xl border-2 border-[var(--sketch-border)] shadow-xl">
            <h3 class="font-header font-bold text-xl text-[var(--sketch-text)] mb-2">Level Mapping Context</h3>
            <div class="levels-display mb-3">
              <span class="text-xs font-mono text-amber-400 font-bold">{company.levelsNote}</span>
            </div>
            <p class="text-xs text-[var(--sketch-text-muted)] font-sketch">
              We recommend cross-referencing salary benchmarks directly at <a href="https://www.levels.fyi" target="_blank" rel="noopener noreferrer" class="text-amber-500 underline">levels.fyi</a>.
            </p>
          </div>
        </div>
      </div>

      {/* Sketch Blackboard Footer */}
      <footer class="sketch-border bg-[var(--sketch-bg-dim)] p-8 md:p-10 rounded-2xl font-sketch shadow-xl mt-16 max-w-6xl mx-auto mb-10">
        {/* Top Branding & Description */}
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-8 border-b border-[var(--sketch-border)]">
          <div>
            <div class="flex items-center gap-3 mb-2">
              <span class="text-3xl">🏢</span>
              <h3 class="text-2xl font-bold font-header text-[var(--sketch-text)]">
                {company.name} Interview Studio
              </h3>
            </div>
            <p class="text-[var(--sketch-text-muted)] text-sm max-w-2xl leading-relaxed font-sketch">
              Round-by-round process map, curated problem sets, and study tracks for {company.name}.
            </p>
          </div>

          <div class="flex items-center gap-3">
            <a
              href="https://github.com/prathameshp107/DSA-Notes-Problems"
              target="_blank"
              rel="noopener noreferrer"
              class="sketch-button flex items-center gap-2 text-sm font-bold bg-amber-500/20 border-amber-500"
            >
              <span>⭐ Star on GitHub</span>
            </a>
            <button
              onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
              class="sketch-button flex items-center gap-1.5 text-sm font-bold"
              title="Back to top"
            >
              <span>↑ Top</span>
            </button>
          </div>
        </div>

        {/* 4-Column Quick Links Grid */}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-8 border-b border-[var(--sketch-border)]">
          {/* Column 1: Featured Tracks */}
          <div>
            <h4 class="font-header font-bold text-base text-[var(--sketch-accent-orange)] mb-3 flex items-center gap-2">
              <span>🎯</span> Company Tracks
            </h4>
            <ul class="space-y-2 text-sm text-[var(--sketch-text-muted)] font-sketch">
              <li>
                <a href={`${base}companies/google`} class="hover:text-[var(--sketch-text)] hover:underline flex items-center gap-1.5">
                  <span>•</span> Google SDE Track
                </a>
              </li>
              <li>
                <a href={`${base}companies/amazon`} class="hover:text-[var(--sketch-text)] hover:underline flex items-center gap-1.5">
                  <span>•</span> Amazon SDE Track
                </a>
              </li>
              <li>
                <a href={`${base}companies`} class="hover:text-[var(--sketch-text)] hover:underline flex items-center gap-1.5">
                  <span>•</span> All Company Directories
                </a>
              </li>
            </ul>
          </div>

          {/* Column 2: Interview Prep */}
          <div>
            <h4 class="font-header font-bold text-base text-[var(--sketch-accent-orange)] mb-3 flex items-center gap-2">
              <span>💡</span> Interview Tools
            </h4>
            <ul class="space-y-2 text-sm text-[var(--sketch-text-muted)] font-sketch">
              <li>
                <a href={`${base}interview-questions`} class="hover:text-[var(--sketch-text)] hover:underline flex items-center gap-1.5">
                  <span>•</span> Interview Questions Hub
                </a>
              </li>
              <li>
                <a href={`${base}labs`} class="hover:text-[var(--sketch-text)] hover:underline flex items-center gap-1.5">
                  <span>•</span> Practice Labs Hub
                </a>
              </li>
            </ul>
          </div>

          {/* Column 3: Design & DSA */}
          <div>
            <h4 class="font-header font-bold text-base text-[var(--sketch-accent-orange)] mb-3 flex items-center gap-2">
              <span>📐</span> Design & DSA
            </h4>
            <ul class="space-y-2 text-sm text-[var(--sketch-text-muted)] font-sketch">
              <li>
                <a href={`${base}system-design`} class="hover:text-[var(--sketch-text)] hover:underline flex items-center gap-1.5">
                  <span>•</span> System Design Hub
                </a>
              </li>
              <li>
                <a href={`${base}visualizer`} class="hover:text-[var(--sketch-text)] hover:underline flex items-center gap-1.5">
                  <span>•</span> Visualizer Studio
                </a>
              </li>
            </ul>
          </div>

          {/* Column 4: Quizzes & Practice */}
          <div>
            <h4 class="font-header font-bold text-base text-[var(--sketch-accent-orange)] mb-3 flex items-center gap-2">
              <span>❓</span> MCQ Quizzes
            </h4>
            <ul class="space-y-2 text-sm text-[var(--sketch-text-muted)] font-sketch">
              <li>
                <a href={`${base}mcq`} class="hover:text-[var(--sketch-text)] hover:underline flex items-center gap-1.5">
                  <span>•</span> All MCQ Categories
                </a>
              </li>
              <li>
                <a href={`${base}mcq/javascript`} class="hover:text-[var(--sketch-text)] hover:underline flex items-center gap-1.5">
                  <span>•</span> JavaScript MCQ
                </a>
              </li>
            </ul>
          </div>
        </div>

        {/* Bottom Copyright & Design Bar */}
        <div class="pt-6 flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-[var(--sketch-text-muted)]">
          <div>
            © {new Date().getFullYear()} {company.name} Track · Hand-crafted Blackboard UI.
          </div>
          <div class="flex items-center gap-4">
            <span class="flex items-center gap-1 text-emerald-500 font-bold">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              {company.rounds?.length || 0} Interview Rounds Verified
            </span>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
