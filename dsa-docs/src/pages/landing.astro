---
import LandingPage from '../components/landing/LandingPage.tsx';
import '../styles/dev-ace-landing.css';
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function() {
        var t = localStorage.getItem('ipd-theme') || localStorage.getItem('starlight-theme');
        if (t === 'light') document.documentElement.classList.remove('dark');
        else document.documentElement.classList.add('dark');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Interview Prep Docs — Code to Interview-Ready</title>
    <meta name="description" content="A developer learning operating system: documentation, interactive labs, a DSA playground, algorithm visualizers, MCQ rounds and company interview prep in one continuous system." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@1,400;1,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <LandingPage client:only="react" />
  </body>
</html>
