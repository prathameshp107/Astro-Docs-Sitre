---
import DSAProblemList from '../../components/dsa/DSAProblemList.jsx';
import AppNav from '../../components/AppNav.jsx';
import '../../styles/dsa-lab.css';
import '../../styles/landing.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Problems — DSA Problem Lab</title>
    <meta name="description" content="Browse DSA problems by topic, difficulty, and company." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <AppNav activeSection="dsa-problems" client:load />
    <DSAProblemList client:load />
  </body>
</html>
