---
import AppNav from '../components/AppNav.jsx';
import '../styles/landing.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

const trails = [
  { href: `${base}problems`, icon: '⚔️', title: 'DSA Problems', desc: 'Hunt down coding challenges', color: 'var(--indigo-500)' },
  { href: `${base}practice`, icon: '🔥', title: 'Coding Labs', desc: 'Practice by the campfire', color: 'var(--amber-500)' },
  { href: `${base}visualizer`, icon: '🗿', title: 'Visualizers', desc: 'See algorithms carved in stone', color: 'var(--cyan-500)' },
  { href: `${base}mcq`, icon: '🏹', title: 'MCQ Quiz', desc: 'Test your tribal knowledge', color: 'var(--green-500)' },
  { href: `${base}plans`, icon: '🗺️', title: 'Study Plans', desc: 'Follow a guided trail', color: 'var(--fuchsia-500)' },
  { href: `${base}system-design`, icon: '🏛️', title: 'System Design', desc: 'Architect bigger caves', color: 'var(--blue-500)' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 — Page Not Found | Interview Prep Buddy</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content="This page was moved, deleted, or eaten by a caveman. Head back to camp and pick another trail." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="nf-body">
    <AppNav client:load />

    <main class="nf-page">
      <!-- faint cave-painting backdrop -->
      <div class="nf-cave-art" aria-hidden="true">
        <span class="nf-glyph" style="top:12%;left:6%">𓃒</span>
        <span class="nf-glyph" style="top:64%;left:11%">𓂭</span>
        <span class="nf-glyph" style="top:22%;right:8%">𓃱</span>
        <span class="nf-glyph" style="top:70%;right:6%">𓊝</span>
        <span class="nf-glyph" style="top:42%;left:3%">𓆉</span>
        <span class="nf-glyph" style="top:48%;right:3%">𓃰</span>
      </div>
      <div class="nf-glow" aria-hidden="true"></div>

      <div class="nf-hero">
        <div class="nf-scene" aria-hidden="true">
          <svg viewBox="0 0 560 360" class="nf-svg" role="img" aria-label="A confused caveman scratching his head next to a stone tablet carved with 404">
            <!-- ground -->
            <ellipse cx="280" cy="330" rx="230" ry="22" class="nf-ground" />

            <!-- stone tablet with 404 -->
            <g class="nf-tablet">
              <path d="M330 320 L338 160 Q340 128 372 124 L448 118 Q482 116 486 148 L494 312 Q495 326 480 327 L346 331 Q331 331 330 320 Z" class="nf-stone" />
              <path d="M338 160 Q340 128 372 124 L448 118 Q470 117 480 130 L360 140 Q344 143 342 168 L336 300 L338 160 Z" class="nf-stone-hi" />
              <text x="414" y="248" text-anchor="middle" class="nf-carved">404</text>
              <path d="M356 282 L470 276" class="nf-crack" />
              <path d="M452 138 L444 156 L458 162" class="nf-crack" />
            </g>

            <!-- bone + pebbles -->
            <g class="nf-props">
              <g transform="translate(96 318) rotate(-14)">
                <rect x="-26" y="-4" width="52" height="8" rx="4" class="nf-bone" />
                <circle cx="-27" cy="-4" r="6" class="nf-bone" />
                <circle cx="-27" cy="4" r="6" class="nf-bone" />
                <circle cx="27" cy="-4" r="6" class="nf-bone" />
                <circle cx="27" cy="4" r="6" class="nf-bone" />
              </g>
              <ellipse cx="470" cy="332" rx="14" ry="7" class="nf-pebble" />
              <ellipse cx="150" cy="334" rx="10" ry="5" class="nf-pebble" />
            </g>

            <!-- caveman -->
            <g class="nf-caveman">
              <ellipse cx="225" cy="332" rx="64" ry="10" class="nf-shadow" />

              <!-- club resting on shoulder -->
              <g class="nf-club" transform="rotate(24 262 232)">
                <path d="M258 236 L270 130 Q272 108 288 106 Q306 104 308 124 L296 238 Q294 250 277 250 Q260 250 258 236 Z" class="nf-wood" />
                <circle cx="284" cy="124" r="4" class="nf-wood-dark" />
                <circle cx="296" cy="150" r="3" class="nf-wood-dark" />
                <circle cx="278" cy="170" r="3.4" class="nf-wood-dark" />
              </g>

              <!-- legs -->
              <path d="M204 300 L200 330 L214 330 L218 300 Z" class="nf-skin" />
              <path d="M242 300 L246 330 L260 330 L254 300 Z" class="nf-skin" />
              <ellipse cx="204" cy="332" rx="13" ry="6" class="nf-skin-dark" />
              <ellipse cx="256" cy="332" rx="13" ry="6" class="nf-skin-dark" />

              <!-- fur tunic -->
              <path d="M186 226 Q225 210 264 226 L272 296 Q270 306 258 304 L246 300 L240 308 L212 308 L206 300 L192 304 Q182 306 180 296 Z" class="nf-fur" />
              <path d="M186 226 L206 258 L226 224 L246 258 L264 226" class="nf-fur-jag" />
              <circle cx="206" cy="278" r="5" class="nf-fur-spot" />
              <circle cx="238" cy="266" r="4" class="nf-fur-spot" />
              <circle cx="228" cy="292" r="4.4" class="nf-fur-spot" />

              <!-- right arm holding club -->
              <path d="M258 236 Q282 240 278 258 Q262 266 252 252 Z" class="nf-skin" />

              <!-- head group (bobs while scratching) -->
              <g class="nf-head">
                <!-- scratching arm -->
                <g class="nf-scratch-arm">
                  <path d="M190 238 Q158 220 166 184 Q172 172 184 178 Q192 196 204 206 Z" class="nf-skin" />
                  <circle cx="172" cy="180" r="9" class="nf-skin" />
                </g>

                <!-- neck + face -->
                <rect x="212" y="196" width="26" height="20" rx="8" class="nf-skin" />
                <circle cx="225" cy="164" r="42" class="nf-skin" />

                <!-- messy hair -->
                <path d="M186 152 Q180 118 208 114 L204 126 L218 110 L220 124 L234 108 L238 124 L252 114 L250 128 L266 124 Q268 144 262 152 Q248 128 225 128 Q198 128 186 152 Z" class="nf-hair" />

                <!-- raised unibrow -->
                <path d="M200 150 Q225 138 250 150" class="nf-brow" />

                <!-- eyes (blink) -->
                <g class="nf-eyes">
                  <circle cx="211" cy="160" r="5" class="nf-eye" />
                  <circle cx="240" cy="160" r="5" class="nf-eye" />
                </g>

                <!-- nose + confused mouth -->
                <ellipse cx="225" cy="174" rx="7" ry="5.4" class="nf-skin-dark" />
                <path d="M212 192 Q220 186 232 192" class="nf-mouth" />

                <!-- beard -->
                <path d="M192 172 Q188 208 212 212 L214 200 L222 214 L230 200 L238 214 L244 198 Q260 196 258 172 Q252 190 225 190 Q198 190 192 172 Z" class="nf-hair" />

                <!-- bone in hair -->
                <g transform="translate(258 128) rotate(30)">
                  <rect x="-14" y="-2.6" width="28" height="5.2" rx="2.6" class="nf-bone" />
                  <circle cx="-15" cy="-2.5" r="3.6" class="nf-bone" />
                  <circle cx="-15" cy="2.5" r="3.6" class="nf-bone" />
                  <circle cx="15" cy="-2.5" r="3.6" class="nf-bone" />
                  <circle cx="15" cy="2.5" r="3.6" class="nf-bone" />
                </g>
              </g>

              <!-- floating question marks -->
              <text x="150" y="112" class="nf-q nf-q1">?</text>
              <text x="284" y="84" class="nf-q nf-q2">?</text>
              <text x="196" y="70" class="nf-q nf-q3">?</text>
            </g>

            <!-- footprints trailing away -->
            <g class="nf-footprints">
              <ellipse cx="52" cy="300" rx="9" ry="5" transform="rotate(-18 52 300)" />
              <ellipse cx="82" cy="316" rx="9" ry="5" transform="rotate(-10 82 316)" />
              <ellipse cx="116" cy="306" rx="9" ry="5" transform="rotate(-16 116 306)" />
            </g>
          </svg>
        </div>

        <div class="nf-copy">
          <div class="nf-badge">
            <span class="nf-badge-dot"></span>
            ERROR 404 · LOST IN THE STONE AGE
          </div>
          <h1 class="nf-title">Ooga booga.<br /><span>Page not found.</span></h1>
          <p class="nf-sub">
            You've wandered off the learning trail. This page was moved, renamed, or
            eaten by a caveman — even our best hunter-gatherers couldn't track it down.
          </p>
          <p class="nf-path" id="nf-path" hidden>
            Tracks end at&nbsp;<code id="nf-path-code"></code>
          </p>
          <div class="nf-actions">
            <a class="nf-btn nf-btn-primary" href={base}>
              <span aria-hidden="true">🏕️</span> Back to camp
            </a>
            <button class="nf-btn nf-btn-ghost" id="nf-back" type="button">
              ← Retrace your steps
            </button>
          </div>
        </div>
      </div>

      <section class="nf-trails" aria-label="Popular sections">
        <h2 class="nf-trails-title">Or pick a well-worn trail</h2>
        <div class="nf-grid">
          {trails.map((t) => (
            <a class="nf-card" href={t.href} style={`--card-accent:${t.color}`}>
              <span class="nf-card-icon" aria-hidden="true">{t.icon}</span>
              <span class="nf-card-body">
                <span class="nf-card-title">{t.title}</span>
                <span class="nf-card-desc">{t.desc}</span>
              </span>
              <span class="nf-card-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    </main>

    <script is:inline>
      (function () {
        var code = document.getElementById('nf-path-code');
        var wrap = document.getElementById('nf-path');
        if (code && wrap && window.location.pathname) {
          code.textContent = window.location.pathname;
          wrap.hidden = false;
        }
        var back = document.getElementById('nf-back');
        if (back) {
          back.addEventListener('click', function () {
            if (window.history.length > 1) window.history.back();
            else window.location.href = document.querySelector('.nf-btn-primary').href;
          });
        }
      })();
    </script>

    <style>
      .nf-body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .nf-page {
        position: relative;
        flex: 1;
        max-width: 1120px;
        width: 100%;
        margin: 0 auto;
        padding: 7.5rem 1.5rem 4rem;
        overflow: hidden;
      }

      /* ── backdrop ─────────────────────────────────────────────── */
      .nf-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(600px 320px at 50% 12%, var(--accent-tint-strong), transparent 70%),
          radial-gradient(420px 260px at 82% 68%, color-mix(in srgb, var(--amber-500) 7%, transparent), transparent 70%);
      }

      .nf-cave-art {
        position: absolute;
        inset: 0;
        pointer-events: none;
        user-select: none;
      }
      .nf-glyph {
        position: absolute;
        font-size: 3.4rem;
        color: var(--text);
        opacity: 0.05;
        transform: rotate(-8deg);
      }
      .nf-glyph:nth-child(even) { transform: rotate(10deg); }

      /* ── hero layout ─────────────────────────────────────────── */
      .nf-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
        align-items: center;
        gap: 2.5rem;
        min-height: 420px;
      }

      .nf-scene { max-width: 560px; }
      .nf-svg { width: 100%; height: auto; display: block; }

      /* ── copy ────────────────────────────────────────────────── */
      .nf-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.9rem;
        border-radius: var(--radius-pill);
        border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
        background: var(--accent-tint);
        color: var(--accent-hover);
        font-family: var(--font-mono);
        font-size: var(--fs-xs);
        font-weight: var(--fw-semibold);
        letter-spacing: 0.08em;
      }
      .nf-badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
        animation: nf-pulse 2s var(--ease-out) infinite;
      }

      .nf-title {
        margin: 1.1rem 0 0.9rem;
        font-family: var(--font-display);
        font-size: clamp(2.2rem, 4.5vw, 3.4rem);
        font-weight: var(--fw-bold);
        line-height: var(--lh-tight);
        color: var(--text);
      }
      .nf-title span {
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
      }

      .nf-sub {
        margin: 0 0 0.9rem;
        max-width: 46ch;
        color: var(--text-secondary);
        font-size: var(--fs-lg);
        line-height: var(--lh-normal);
      }

      .nf-path {
        display: flex;
        align-items: center;
        margin: 0 0 1.6rem;
        color: var(--text-muted);
        font-size: var(--fs-sm);
      }
      .nf-path code {
        font-family: var(--font-mono);
        font-size: var(--fs-xs);
        padding: 0.2rem 0.55rem;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--danger-fg);
        max-width: 32ch;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .nf-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

      .nf-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.4rem;
        border-radius: var(--radius-lg);
        font-family: var(--font-sans);
        font-size: var(--fs-base);
        font-weight: var(--fw-semibold);
        text-decoration: none;
        cursor: pointer;
        transition: transform var(--transition-fast), box-shadow var(--transition-base), background var(--transition-fast), border-color var(--transition-fast);
      }
      .nf-btn-primary {
        background: var(--accent-gradient);
        color: var(--white);
        border: none;
        box-shadow: var(--shadow-accent);
      }
      .nf-btn-primary:hover { transform: translateY(-2px); }
      .nf-btn-ghost {
        background: transparent;
        color: var(--text);
        border: 1px solid var(--border-strong);
      }
      .nf-btn-ghost:hover {
        border-color: var(--accent);
        background: var(--accent-tint);
        transform: translateY(-2px);
      }

      /* ── trails grid ─────────────────────────────────────────── */
      .nf-trails { position: relative; margin-top: 4rem; }
      .nf-trails-title {
        font-family: var(--font-display);
        font-size: var(--fs-xl);
        font-weight: var(--fw-semibold);
        color: var(--text);
        margin: 0 0 1.2rem;
        text-align: center;
      }
      .nf-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
      }
      .nf-card {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 1rem 1.2rem;
        border-radius: var(--radius-xl);
        border: 1px solid var(--border);
        background: var(--surface);
        text-decoration: none;
        transition: transform var(--transition-base), border-color var(--transition-fast), box-shadow var(--transition-base);
      }
      .nf-card:hover {
        transform: translateY(-3px);
        border-color: color-mix(in srgb, var(--card-accent) 55%, transparent);
        box-shadow: 0 12px 28px color-mix(in srgb, var(--card-accent) 16%, transparent);
      }
      .nf-card-icon {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: var(--radius-md);
        font-size: 1.35rem;
        background: color-mix(in srgb, var(--card-accent) 12%, transparent);
        border: 1px solid color-mix(in srgb, var(--card-accent) 25%, transparent);
      }
      .nf-card-body { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
      .nf-card-title { color: var(--text); font-weight: var(--fw-semibold); font-size: var(--fs-base); }
      .nf-card-desc { color: var(--text-secondary); font-size: var(--fs-sm); }
      .nf-card-arrow {
        margin-left: auto;
        color: var(--text-muted);
        font-size: var(--fs-lg);
        transition: transform var(--transition-fast), color var(--transition-fast);
      }
      .nf-card:hover .nf-card-arrow { transform: translateX(4px); color: var(--card-accent); }

      /* ── SVG scene colors (theme-aware) ──────────────────────── */
      .nf-ground { fill: color-mix(in srgb, var(--text) 6%, transparent); }
      .nf-shadow { fill: color-mix(in srgb, var(--black) 18%, transparent); }
      .nf-stone { fill: var(--slate-400); stroke: var(--slate-500); stroke-width: 2; }
      .nf-stone-hi { fill: color-mix(in srgb, var(--white) 26%, transparent); }
      .nf-carved {
        font-family: var(--font-display);
        font-size: 74px;
        font-weight: 700;
        fill: var(--slate-700);
        letter-spacing: 2px;
      }
      .nf-crack { stroke: var(--slate-600); stroke-width: 2; fill: none; stroke-linecap: round; }
      .nf-skin { fill: #e8b184; }
      .nf-skin-dark { fill: #c98d61; }
      .nf-hair { fill: #4a3628; }
      .nf-brow { stroke: #4a3628; stroke-width: 6; fill: none; stroke-linecap: round; }
      .nf-eye { fill: #241a12; }
      .nf-mouth { stroke: #7a4a2e; stroke-width: 3.6; fill: none; stroke-linecap: round; }
      .nf-fur { fill: #b98142; stroke: #96652f; stroke-width: 2; }
      .nf-fur-jag { fill: none; stroke: #96652f; stroke-width: 2; }
      .nf-fur-spot { fill: #8a5a26; }
      .nf-wood { fill: #9c6b3f; stroke: #7a5230; stroke-width: 2; }
      .nf-wood-dark { fill: #7a5230; }
      .nf-bone { fill: #ece4d4; stroke: #c9bda3; stroke-width: 1.4; }
      .nf-pebble { fill: color-mix(in srgb, var(--text) 14%, transparent); }
      .nf-footprints ellipse { fill: color-mix(in srgb, var(--text) 12%, transparent); }
      .nf-q {
        font-family: var(--font-display);
        font-weight: 700;
        fill: var(--accent);
        opacity: 0;
      }
      .nf-q1 { font-size: 34px; animation: nf-float 3.2s ease-in-out infinite; }
      .nf-q2 { font-size: 26px; animation: nf-float 3.2s ease-in-out 1.1s infinite; }
      .nf-q3 { font-size: 20px; animation: nf-float 3.2s ease-in-out 2.1s infinite; }

      :root[data-theme='dark'] .nf-stone { fill: var(--slate-600); stroke: var(--slate-700); }
      :root[data-theme='dark'] .nf-carved { fill: var(--slate-300); }
      :root[data-theme='dark'] .nf-crack { stroke: var(--slate-400); }
      :root[data-theme='dark'] .nf-stone-hi { fill: color-mix(in srgb, var(--white) 8%, transparent); }

      /* ── animation ───────────────────────────────────────────── */
      .nf-caveman { animation: nf-bob 4s ease-in-out infinite; transform-origin: 225px 330px; }
      .nf-head { animation: nf-tilt 4s ease-in-out infinite; transform-origin: 225px 200px; }
      .nf-scratch-arm { animation: nf-scratch 1.4s ease-in-out infinite; transform-origin: 196px 226px; }
      .nf-eyes { animation: nf-blink 4.6s infinite; transform-origin: 225px 160px; }
      .nf-tablet { animation: nf-settle 6s ease-in-out infinite; transform-origin: 414px 330px; }

      @keyframes nf-bob {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-5px); }
      }
      @keyframes nf-tilt {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(-3deg); }
      }
      @keyframes nf-scratch {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(-9deg); }
      }
      @keyframes nf-blink {
        0%, 44%, 50%, 100% { transform: scaleY(1); }
        47% { transform: scaleY(0.08); }
      }
      @keyframes nf-settle {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(0.6deg); }
      }
      @keyframes nf-float {
        0% { opacity: 0; transform: translateY(6px); }
        30% { opacity: 0.9; }
        70% { opacity: 0.9; }
        100% { opacity: 0; transform: translateY(-16px); }
      }
      @keyframes nf-pulse {
        0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 45%, transparent); }
        60% { box-shadow: 0 0 0 7px transparent; }
      }

      @media (prefers-reduced-motion: reduce) {
        .nf-caveman, .nf-head, .nf-scratch-arm, .nf-eyes, .nf-tablet,
        .nf-q1, .nf-q2, .nf-q3, .nf-badge-dot { animation: none; }
        .nf-q { opacity: 0.8; }
      }

      /* ── responsive ──────────────────────────────────────────── */
      @media (max-width: 860px) {
        .nf-page { padding-top: 6rem; }
        .nf-hero {
          grid-template-columns: 1fr;
          gap: 1.2rem;
          text-align: center;
        }
        .nf-scene { max-width: 440px; margin: 0 auto; }
        .nf-sub { margin-inline: auto; }
        .nf-path { justify-content: center; }
        .nf-actions { justify-content: center; }
      }
    </style>
  </body>
</html>
