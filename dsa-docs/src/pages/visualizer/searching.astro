---
import DSAVisualizerPage from '../../components/visualizers/DSAVisualizerPage.jsx';
import AppNav from '../../components/AppNav.jsx';
import PageSEO from '../../components/PageSEO.astro';
import '../../styles/mcq-tailwind.css';
import '../../styles/landing.css';
import '../../styles/sketch-visualizer.css';

const SITE_URL = 'https://interviewpreprationbuddy.in';
const PAGE_URL = `${SITE_URL}/visualizer/searching`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: 'Binary Search Visualizer — Step-by-Step Search Algorithm Animation',
  description: 'Interactive binary search and linear search visualizer. See how binary search eliminates half the search space at each step with animations showing mid-point calculation and target comparison.',
  url: PAGE_URL,
  image: `${SITE_URL}/assets/og-image.png`,
  educationalLevel: 'beginner',
  learningResourceType: 'Interactive Tool',
  teaches: ['Binary search algorithm', 'Linear search algorithm', 'Binary search time complexity O(log n)', 'Binary search implementation', 'Binary search variations'],
  about: [{ '@type': 'Thing', name: 'Binary Search' }, { '@type': 'Thing', name: 'Search Algorithms' }],
  author: { '@id': `${SITE_URL}/#author` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  isPartOf: { '@type': 'WebSite', '@id': `${SITE_URL}/#website` },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How Binary Search Works — Step by Step',
  url: PAGE_URL,
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Start with a Sorted Array', text: 'Binary search only works on sorted arrays. Set low = 0 and high = array.length - 1.' },
    { '@type': 'HowToStep', position: 2, name: 'Calculate the Mid Point', text: 'mid = Math.floor((low + high) / 2). Compare array[mid] with the target.' },
    { '@type': 'HowToStep', position: 3, name: 'Eliminate Half the Search Space', text: 'If array[mid] === target, found! If array[mid] < target, search right half (low = mid + 1). If array[mid] > target, search left half (high = mid - 1).' },
    { '@type': 'HowToStep', position: 4, name: 'Repeat Until Found or Exhausted', text: 'Continue halving until low > high (not found) or array[mid] equals target. Each step eliminates half the remaining elements — O(log n) total steps.' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the time complexity of binary search?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Binary search time complexity is O(log n) — each comparison eliminates half the remaining search space. With 1 million elements, binary search takes at most 20 steps (log₂ 1,000,000 ≈ 20). Space complexity is O(1) for iterative, O(log n) for recursive. Binary search only works on sorted arrays.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is binary search different from linear search?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Linear search: O(n) time, works on unsorted arrays, checks every element. Binary search: O(log n) time, requires sorted array, eliminates half the elements each step. For 1000 elements: linear search may check all 1000; binary search checks at most 10. Use linear search for small/unsorted data; binary search for large sorted arrays.',
      },
    },
    {
      '@type': 'Question',
      name: 'What are the variations of binary search used in interviews?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Common binary search variations in interviews: 1) Find first occurrence of target (move high = mid when found), 2) Find last occurrence (move low = mid when found), 3) Search in rotated sorted array (determine which half is sorted), 4) Find peak element, 5) Search in 2D matrix (treat as 1D sorted array), 6) Koko Eating Bananas / capacity-based binary search on answer space.',
      },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="Binary Search Visualizer — Step-by-Step O(log n) Animation | Interview Prep Buddy"
      description="Interactive binary search and linear search visualizer. See how binary search eliminates half the search space at each step. Includes Big-O analysis, interview variations, and step-by-step animations."
      url={PAGE_URL}
      keywords="binary search visualizer, binary search animation, binary search step by step, O(log n) search, linear search vs binary search, binary search algorithm visualizer, search algorithm visualization"
      ogType="article"
      schema={schema}
      faqSchema={faqSchema}
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Visualizer', url: '/visualizer' }, { name: 'Search Algorithms', url: '/visualizer/searching' }]}
      fontUrl="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Caveat:wght@600&family=Patrick+Hand&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  </head>
  <body class="mcq-body">
    <div style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;" aria-hidden="true">
      <h1>Binary Search Visualizer — Interactive Step-by-Step O(log n) Animation</h1>
      <p>Binary search finds a target in a sorted array in O(log n) time by repeatedly halving the search space. For 1 million elements, it takes just 20 comparisons. Visualize each step: set low/high pointers, calculate mid, eliminate half the array, repeat.</p>
      <h2>How Binary Search Works</h2>
      <ol>
        <li>Requires a sorted array. Set low = 0, high = array.length - 1</li>
        <li>Calculate mid = Math.floor((low + high) / 2)</li>
        <li>If array[mid] === target: found, return mid</li>
        <li>If array[mid] &lt; target: search right half, set low = mid + 1</li>
        <li>If array[mid] &gt; target: search left half, set high = mid - 1</li>
        <li>Repeat until low &gt; high (not found, return -1)</li>
      </ol>
      <h2>Related Visualizers</h2>
      <ul>
        <li><a href="/visualizer/sorting">Sorting Algorithm Visualizer</a></li>
        <li><a href="/visualizer/two-pointers">Two Pointers Visualizer</a></li>
        <li><a href="/visualizer">All Algorithm Visualizers</a></li>
      </ul>
    </div>
    <AppNav activeSection="visualizer" client:load />
    <DSAVisualizerPage topicId="searching" client:load />
  </body>
</html>