---
import DSAVisualizerPage from '../../components/visualizers/DSAVisualizerPage.jsx';
import AppNav from '../../components/AppNav.jsx';
import PageSEO from '../../components/PageSEO.astro';
import { getVisualizerFaqSchema } from '../../data/visualizers/visualizerContent.js';
import '../../styles/mcq-tailwind.css';
import '../../styles/landing.css';
import '../../styles/sketch-visualizer.css';

const SITE_URL = 'https://interviewpreprationbuddy.in';
const PAGE_URL = `${SITE_URL}/visualizer/trees/`;

// FAQ structured data generated from the same VISUALIZER_CONTENT entry that
// VisualizerArticle renders on-page, so schema and visible copy stay in sync.
const faqSchema = getVisualizerFaqSchema('trees', PAGE_URL);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: 'Binary Tree Visualizer — BST Insertion, Deletion & Traversal Animations',
  description: 'Interactive binary tree and BST visualizer. See insertion, deletion, BFS level-order, DFS inorder/preorder/postorder traversals with step-by-step animations and Big-O analysis.',
  url: PAGE_URL,
  image: `${SITE_URL}/assets/og-image.png`,
  educationalLevel: 'intermediate',
  learningResourceType: 'Interactive Tool',
  teaches: ['Binary tree traversal', 'BST insertion and deletion', 'BFS level-order traversal', 'DFS inorder preorder postorder', 'Binary search tree properties'],
  about: [{ '@type': 'Thing', name: 'Binary Trees' }, { '@type': 'Thing', name: 'Binary Search Tree' }],
  author: { '@id': `${SITE_URL}/#author` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  isPartOf: { '@type': 'WebSite', '@id': `${SITE_URL}/#website` },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Visualize Binary Tree Traversals',
  description: 'Step-by-step guide to using the binary tree visualizer for interview preparation',
  url: PAGE_URL,
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Build the Tree', text: 'Insert values by clicking "Insert" and entering a number. The BST property (left < root < right) is maintained automatically.' },
    { '@type': 'HowToStep', position: 2, name: 'Select a Traversal', text: 'Choose BFS (level-order), DFS Inorder, DFS Preorder, or DFS Postorder from the traversal menu.' },
    { '@type': 'HowToStep', position: 3, name: 'Run the Animation', text: 'Click "Traverse" to see nodes highlighted in visit order with the traversal path shown step-by-step.' },
    { '@type': 'HowToStep', position: 4, name: 'Study the Output', text: 'The output array shows the visit order. For Inorder on a BST, this is always sorted ascending — useful for interview problems.' },
  ],
};

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="Binary Tree Visualizer — BST Traversal Animations BFS DFS | Interview Prep Buddy"
      description="Interactive binary tree and BST visualizer. Animate insertion, deletion, BFS level-order, DFS inorder/preorder/postorder traversals step-by-step with Big-O complexity analysis."
      url={PAGE_URL}
      keywords="binary tree visualizer, BST visualizer, tree traversal animation, inorder preorder postorder, BFS DFS tree, binary search tree visualization, level order traversal, tree algorithm visualizer"
      ogType="article"
      schema={schema}
      faqSchema={faqSchema}
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Visualizer', url: '/visualizer' }, { name: 'Binary Tree Visualizer', url: '/visualizer/trees' }]}
      fontUrl="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Caveat:wght@600&family=Patrick+Hand&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  </head>
  <body class="mcq-body">
    <AppNav activeSection="visualizer" client:load />
    <DSAVisualizerPage topicId="trees" client:load />
  </body>
</html>