---
import DSAVisualizerPage from '../../components/visualizers/DSAVisualizerPage.jsx';
import AppNav from '../../components/AppNav.jsx';
import PageSEO from '../../components/PageSEO.astro';
import { getVisualizerFaqSchema } from '../../data/visualizers/visualizerContent.js';
import '../../styles/mcq-tailwind.css';
import '../../styles/landing.css';
import '../../styles/sketch-visualizer.css';

const SITE_URL = 'https://interviewpreprationbuddy.in';
const PAGE_URL = `${SITE_URL}/visualizer/sorting/`;

// FAQ structured data generated from the same VISUALIZER_CONTENT entry that
// VisualizerArticle renders on-page, so schema and visible copy stay in sync.
const faqSchema = getVisualizerFaqSchema('sorting', PAGE_URL);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: 'Sorting Algorithm Visualizer — Bubble, Merge, Quick Sort Animations',
  description: 'Visualize Bubble Sort, Merge Sort, Quick Sort, Insertion Sort, and Selection Sort with interactive step-by-step animations. Compare time complexity (Big-O) and see exactly how each sorting algorithm works.',
  url: PAGE_URL,
  image: `${SITE_URL}/assets/og-image.png`,
  educationalLevel: 'beginner',
  learningResourceType: 'Interactive Tool',
  teaches: ['Bubble Sort', 'Merge Sort', 'Quick Sort', 'Insertion Sort', 'Selection Sort', 'Time complexity Big-O', 'Space complexity analysis'],
  about: [{ '@type': 'Thing', name: 'Sorting Algorithms' }, { '@type': 'Thing', name: 'Algorithm Visualization' }],
  author: { '@id': `${SITE_URL}/#author` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  isPartOf: { '@type': 'WebSite', '@id': `${SITE_URL}/#website` },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Use the Sorting Algorithm Visualizer',
  description: 'Step-by-step guide to visualizing sorting algorithms with interactive animations',
  url: PAGE_URL,
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Select a Sorting Algorithm', text: 'Choose from Bubble Sort, Merge Sort, Quick Sort, Insertion Sort, or Selection Sort from the dropdown menu.' },
    { '@type': 'HowToStep', position: 2, name: 'Set the Array Size', text: 'Use the slider to set the number of elements (bars) in the array. More elements show the algorithm at larger scale.' },
    { '@type': 'HowToStep', position: 3, name: 'Adjust Animation Speed', text: 'Use the speed control to slow down the animation. Slower speeds are better for learning; faster speeds compare algorithms at scale.' },
    { '@type': 'HowToStep', position: 4, name: 'Start the Visualization', text: 'Click the "Sort" or "Visualize" button to start the step-by-step sorting animation with highlighted comparisons and swaps.' },
    { '@type': 'HowToStep', position: 5, name: 'Study the Complexity', text: 'Read the time and space complexity panel showing Big-O notation for best, average, and worst case performance of the algorithm.' },
  ],
};

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="Sorting Algorithm Visualizer — Bubble, Merge, Quick Sort Animated | Interview Prep Buddy"
      description="Visualize Bubble Sort, Merge Sort, Quick Sort, Insertion Sort, and Selection Sort with step-by-step animations. Compare Big-O time complexity and see how each sorting algorithm works internally."
      url={PAGE_URL}
      keywords="sorting algorithm visualizer, bubble sort animation, merge sort visualization, quick sort step by step, insertion sort animation, selection sort visualizer, sorting algorithm comparison, algorithm visualizer free, Big O sorting"
      ogType="article"
      schema={schema}
      faqSchema={faqSchema}
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Visualizer', url: '/visualizer' }, { name: 'Sorting Algorithms', url: '/visualizer/sorting' }]}
      fontUrl="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Caveat:wght@600&family=Patrick+Hand&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  </head>
  <body class="mcq-body">
    <AppNav activeSection="visualizer" client:load />
    <DSAVisualizerPage topicId="sorting" client:load />
  </body>
</html>