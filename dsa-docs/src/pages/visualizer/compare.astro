---
import AlgorithmCompareVisualizer from '../../components/visualizers/AlgorithmCompareVisualizer.jsx';
import AppNav from '../../components/AppNav.jsx';
import PageSEO from '../../components/PageSEO.astro';
import '../../styles/mcq-tailwind.css';
import '../../styles/landing.css';
import '../../styles/sketch-visualizer.css';

const SITE_URL = 'https://interviewpreprationbuddy.in';
const PAGE_URL = `${SITE_URL}/visualizer/compare/`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: 'Algorithm Comparison Visualizer — Race Sorting Algorithms Side by Side',
  description: 'Interactive side-by-side sorting algorithm comparison visualizer. Race Bubble Sort vs Merge Sort, Quick Sort vs Selection Sort with real-time comparison counters, swap metrics, and Big-O benchmarks.',
  url: PAGE_URL,
  image: `${SITE_URL}/assets/og-image.png`,
  educationalLevel: 'intermediate',
  learningResourceType: 'Interactive Tool',
  teaches: ['Algorithm efficiency comparison', 'Bubble Sort vs Merge Sort', 'Quick Sort vs Selection Sort', 'Big-O notation in practice', 'Impact of input distributions (Random vs Reversed vs Nearly Sorted)'],
  about: [{ '@type': 'Thing', name: 'Algorithm Comparison' }, { '@type': 'Thing', name: 'Sorting Algorithms' }],
  author: { '@id': `${SITE_URL}/#author` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  isPartOf: { '@type': 'WebSite', '@id': `${SITE_URL}/#website` },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Compare Algorithms Side-by-Side',
  description: 'Step-by-step guide to benchmarking sorting algorithms interactively',
  url: PAGE_URL,
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Select Two Algorithms', text: 'Choose Algorithm 1 (e.g. Bubble Sort) and Algorithm 2 (e.g. Merge Sort) from the dropdowns.' },
    { '@type': 'HowToStep', position: 2, name: 'Choose Input Distribution', text: 'Select Random, Reversed (worst case for quadratic sorts), or Nearly Sorted array.' },
    { '@type': 'HowToStep', position: 3, name: 'Start the Race', text: 'Click "Start Race" to watch both algorithms execute in parallel with live comparison and swap telemetry.' },
    { '@type': 'HowToStep', position: 4, name: 'Analyze Asymptotic Differences', text: 'Examine why logarithmic algorithms (O(N log N)) drastically outperform quadratic algorithms (O(N²)) as data size scales.' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Why is Merge Sort faster than Bubble Sort?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Bubble Sort compares every adjacent pair repeatedly, requiring O(N²) quadratic comparisons. Merge Sort splits the array in half recursively (log N levels), requiring only O(N log N) total operations. On 1,000 items, Bubble Sort takes ~500,000 operations while Merge Sort takes only ~10,000.',
      },
    },
    {
      '@type': 'Question',
      name: 'When can Insertion Sort beat Quick Sort?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'On nearly sorted arrays, Insertion Sort runs in O(N) linear time because elements barely need to shift. It also has minimal constant-factor overhead, which is why hybrid algorithms like Timsort (used in Python and Java) switch to Insertion Sort for small subarrays.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does asymptotic Big-O complexity actually mean?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Big-O describes how the execution time or space requirements grow as the input size N approaches infinity. It ignores constant factors and machine specifics to classify algorithmic scalability.',
      },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="Algorithm Comparison Visualizer — Race Sorting Algorithms Side by Side | Interview Prep Buddy"
      description="Interactive side-by-side sorting algorithm comparison visualizer. Race Bubble Sort vs Merge Sort, Quick Sort vs Selection Sort with real-time comparison counters, swap metrics, and Big-O benchmarks."
      url={PAGE_URL}
      keywords="algorithm comparison visualizer, bubble sort vs merge sort, sorting algorithm race, compare sorting algorithms, algorithm visualizer side by side, Big O visual benchmark, sorting visualizer race"
      ogType="article"
      schema={schema}
      faqSchema={faqSchema}
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Visualizer', url: '/visualizer' }, { name: 'Algorithm Comparison', url: '/visualizer/compare' }]}
      fontUrl="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Caveat:wght@600&family=Patrick+Hand&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  </head>
  <body class="mcq-body">
    <AppNav activeSection="visualizer" client:load />

    <main class="max-w-6xl mx-auto px-4 py-8 font-sketch">
      <div className="mb-8">
        <a
          href="/visualizer"
          class="inline-flex items-center gap-1.5 text-sm font-mono text-[var(--sketch-text-muted)] hover:text-[var(--sketch-text)] transition-colors mb-4"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><polyline points="15 18 9 12 15 6" /></svg>
          Back to Visualizers Hub
        </a>

        <div class="flex items-center gap-3 mb-2">
          <span class="text-4xl">⚡</span>
          <h1 class="text-3xl md:text-5xl font-bold font-header text-[var(--sketch-text)]">
            Algorithm Comparison Visualizer
          </h1>
        </div>
        <p class="text-[var(--sketch-text-muted)] text-base md:text-lg max-w-3xl leading-relaxed">
          Race two sorting algorithms side-by-side on the exact same dataset. Witness why O(N log N) dominates O(N²) in real time through synchronized comparison counters and swap metrics.
        </p>
      </div>

      <!-- Interactive Comparator Island -->
      <AlgorithmCompareVisualizer client:load />

      {/* Related Visualizers Links */}
      <section class="mt-12 sketch-border bg-[var(--sketch-bg-dim)] p-6 rounded-2xl shadow-xl">
        <h3 class="text-xl font-bold font-header text-[var(--sketch-text)] mb-3 flex items-center gap-2">
          <span>🔗</span> Explore Individual Algorithm Visualizers
        </h3>
        <div class="flex flex-wrap gap-2.5">
          <a href="/visualizer/sorting/" class="sketch-button px-4 py-2 text-sm font-hand text-base rounded-xl">Sorting Hub →</a>
          <a href="/visualizer/bubble-sort/" class="sketch-button px-4 py-2 text-sm font-hand text-base rounded-xl">Bubble Sort Deep Dive →</a>
          <a href="/visualizer/dijkstra/" class="sketch-button px-4 py-2 text-sm font-hand text-base rounded-xl">Dijkstra Shortest Path →</a>
          <a href="/visualizer/knapsack/" class="sketch-button px-4 py-2 text-sm font-hand text-base rounded-xl">0/1 Knapsack DP →</a>
          <a href="/visualizer/searching/" class="sketch-button px-4 py-2 text-sm font-hand text-base rounded-xl">Binary Search →</a>
          <a href="/visualizer/trees/" class="sketch-button px-4 py-2 text-sm font-hand text-base rounded-xl">Binary Search Tree →</a>
        </div>
      </section>
    </main>
  </body>
</html>
