---
import DSAVisualizerPage from '../../components/visualizers/DSAVisualizerPage.jsx';
import AppNav from '../../components/AppNav.jsx';
import PageSEO from '../../components/PageSEO.astro';
import '../../styles/mcq-tailwind.css';
import '../../styles/landing.css';
import '../../styles/sketch-visualizer.css';

const SITE_URL = 'https://interviewpreprationbuddy.in';
const PAGE_URL = `${SITE_URL}/visualizer/bubble-sort/`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: 'Bubble Sort Visualizer — Step-by-Step Animation & Complexity',
  description: 'Visualize Bubble Sort with step-by-step adjacent element comparisons and swaps. Understand O(n^2) worst-case time complexity, in-place sorting, and early-exit optimization.',
  url: PAGE_URL,
  image: `${SITE_URL}/assets/og-image.png`,
  educationalLevel: 'beginner',
  learningResourceType: 'Interactive Tool',
  teaches: ['Bubble Sort algorithm', 'Adjacent element swapping', 'Pass-by-pass bubbling mechanism', 'O(n^2) time complexity', 'Stable sorting property'],
  about: [{ '@type': 'Thing', name: 'Bubble Sort' }, { '@type': 'Thing', name: 'Sorting Algorithm Visualization' }],
  author: { '@id': `${SITE_URL}/#author` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  isPartOf: { '@type': 'WebSite', '@id': `${SITE_URL}/#website` },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Visualize Bubble Sort',
  description: 'Step-by-step guide to visualizing Bubble Sort algorithm with interactive animations',
  url: PAGE_URL,
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Observe Adjacent Comparisons', text: 'Bubble sort starts at the first pair (indices 0 and 1) and compares their values.' },
    { '@type': 'HowToStep', position: 2, name: 'Watch the Swap', text: 'If the left element is greater than the right element, the algorithm swaps them with an animated arc.' },
    { '@type': 'HowToStep', position: 3, name: 'Bubble Largest to the End', text: 'By the end of the first pass, the largest element is guaranteed to be in its correct final position at the end of the array.' },
    { '@type': 'HowToStep', position: 4, name: 'Repeat for Remaining Elements', text: 'Pass 2 bubbles the second largest element, reducing the unsorted subarray size by 1 until the entire array is sorted.' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How does Bubble Sort work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Bubble Sort iterates through an array, comparing adjacent elements and swapping them if they are in the wrong order. With each full pass, the largest unsorted element "bubbles" up to its correct final index.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the time complexity of Bubble Sort?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Worst and average case time complexity is O(n^2) due to nested loops. With an optimized swapped flag that detects when no swaps occur in a pass, the best case (already sorted array) is O(n). Space complexity is strictly O(1) in-place.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is Bubble Sort stable?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes! Bubble Sort only swaps when arr[j] > arr[j+1] (strict inequality). Equal elements never pass each other, preserving their relative original order.',
      },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="Bubble Sort Visualizer — Step-by-Step Animation & Complexity | Interview Prep Buddy"
      description="Visualize Bubble Sort with step-by-step adjacent element comparisons and swaps. Understand O(n^2) worst-case time complexity, in-place sorting, and early-exit optimization."
      url={PAGE_URL}
      keywords="bubble sort visualizer, bubble sort animation, bubble sort step by step, bubble sort algorithm visualization, bubble sort time complexity, sorting visualizer free"
      ogType="article"
      schema={schema}
      faqSchema={faqSchema}
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Visualizer', url: '/visualizer' }, { name: 'Bubble Sort', url: '/visualizer/bubble-sort' }]}
      fontUrl="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Caveat:wght@600&family=Patrick+Hand&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  </head>
  <body class="mcq-body">
    <AppNav activeSection="visualizer" client:load />
    <DSAVisualizerPage topicId="sorting" initialTrack="bubble-sort" client:load />
  </body>
</html>
