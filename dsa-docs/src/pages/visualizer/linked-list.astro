---
import DSAVisualizerPage from '../../components/visualizers/DSAVisualizerPage.jsx';
import AppNav from '../../components/AppNav.jsx';
import PageSEO from '../../components/PageSEO.astro';
import { getVisualizerFaqSchema } from '../../data/visualizers/visualizerContent.js';
import '../../styles/mcq-tailwind.css';
import '../../styles/landing.css';
import '../../styles/sketch-visualizer.css';

const SITE_URL = 'https://interviewpreprationbuddy.in';
const PAGE_URL = `https://interviewpreprationbuddy.in/visualizer/linked-list/`;

// FAQ structured data generated from the same VISUALIZER_CONTENT entry that
// VisualizerArticle renders on-page, so schema and visible copy stay in sync.
const faqSchema = getVisualizerFaqSchema('linked-list', PAGE_URL);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: 'Linked List Visualizer — Insert, Delete, Reverse & Cycle Detection | Interview Prep Buddy',
  description: 'Follow every pointer reassignment as nodes are inserted, deleted and reversed. Includes Floyd’s fast and slow pointer cycle detection, and singly versus doubly linked list trade-offs.',
  url: PAGE_URL,
  image: `https://interviewpreprationbuddy.in/assets/og-image.png`,
  educationalLevel: 'intermediate',
  learningResourceType: 'Interactive Tool',
  about: [{ '@type': 'Thing', name: 'Linked List' }, { '@type': 'Thing', name: 'Algorithm Visualization' }],
  author: { '@id': `https://interviewpreprationbuddy.in/#author` },
  publisher: { '@id': `https://interviewpreprationbuddy.in/#organization` },
  isPartOf: { '@type': 'WebSite', '@id': `https://interviewpreprationbuddy.in/#website` },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="Linked List Visualizer — Insert, Delete, Reverse & Cycle Detection | Interview Prep Buddy"
      description="Follow every pointer reassignment as nodes are inserted, deleted and reversed. Includes Floyd’s fast and slow pointer cycle detection, and singly versus doubly linked list trade-offs."
      url={PAGE_URL}
      keywords="linked list visualizer, reverse linked list animation, cycle detection Floyd algorithm, singly doubly linked list, linked list insertion deletion, fast slow pointer, dummy head node"
      schema={schema}
      faqSchema={faqSchema}
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Visualizer', url: '/visualizer' }, { name: 'Linked List Visualizer', url: `/visualizer/linked-list` }]}
      fontUrl="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Caveat:wght@600&family=Patrick+Hand&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="mcq-body">
    <AppNav activeSection="visualizer" client:load />
    <DSAVisualizerPage topicId="linked-list" client:load />
  </body>
</html>