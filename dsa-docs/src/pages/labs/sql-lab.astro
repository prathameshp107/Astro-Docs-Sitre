---
import SQLLabsPlatform from '../../components/labs/SQLLabsPlatform.jsx';
import AppNav from '../../components/AppNav.jsx';
import '../../styles/landing.css';
import '../../styles/practice-labs.css';
import '../../styles/lab-base.css';
import '../../styles/sql-labs.css';
import PageSEO from '../../components/PageSEO.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="SQL Interactive Labs — Interview Prep Buddy"
      description="Master SQL with interactive browser-based labs. Practice SELECT, JOINs, subqueries, GROUP BY, indexes, and stored procedures."
      url="https://interviewpreprationbuddy.in/labs/sql-lab"
      keywords="SQL practice lab, SQL exercises online, interactive SQL learning, SQL coding challenges"
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Labs', url: '/labs' }, { name: 'SQL Interactive Labs', url: '/labs/sql-lab' }]}
    />
  </head>
  <body>
    <AppNav activeSection="labs" client:load />
    <SQLLabsPlatform client:only="react" />
  </body>
</html>