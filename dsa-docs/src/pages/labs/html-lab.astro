---
import HTMLLabsPlatform from '../../components/labs/html/HTMLLabsPlatform.jsx';
import AppNav from '../../components/AppNav.jsx';
import '../../styles/landing.css';
import '../../styles/practice-labs.css';
import '../../styles/lab-base.css';
import PageSEO from '../../components/PageSEO.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="HTML Interactive Labs — Interview Prep Buddy"
      description="Learn HTML with interactive browser-based labs. Practice semantic HTML, forms, accessibility, and document structure with live preview."
      url="https://interviewpreprationbuddy.in/labs/html-lab"
      keywords="HTML practice lab, interactive HTML exercises, HTML coding challenges, HTML learning platform"
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Labs', url: '/labs' }, { name: 'HTML Interactive Labs', url: '/labs/html-lab' }]}
    />
  </head>
  <body>
    <AppNav activeSection="html-lab" client:load />
    <HTMLLabsPlatform client:only="react" />
  </body>
</html>