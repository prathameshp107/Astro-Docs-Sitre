---
import PythonLanding from '../../components/labs/PythonLanding.jsx';
import AppNav from '../../components/AppNav.jsx';
import '../../styles/landing.css';
import '../../styles/practice-labs.css';
import PageSEO from '../../components/PageSEO.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="Python Reference Labs — Interview Prep Buddy"
      description="Interactive Python reference with code examples covering syntax, data structures, OOP, algorithms, and Python standard library."
      url="https://interviewpreprationbuddy.in/labs/python"
      keywords="Python reference interactive, Python code examples, learn Python online"
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Labs', url: '/labs' }, { name: 'Python Reference Labs', url: '/labs/python' }]}
    />
  </head>
  <body>
    <AppNav activeSection="python" client:load />
    <PythonLanding client:load />
  </body>
</html>