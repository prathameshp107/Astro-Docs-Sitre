---
import CSSLabsPlatform from '../../components/labs/css/CSSLabsPlatform.jsx';
import AppNav from '../../components/AppNav.jsx';
import '../../styles/landing.css';
import '../../styles/practice-labs.css';
import '../../styles/lab-base.css';
import PageSEO from '../../components/PageSEO.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="CSS Interactive Labs — Interview Prep Buddy"
      description="Master CSS with hands-on interactive labs. Practice selectors, flexbox, grid, animations, and responsive design with live preview."
      url="https://interviewpreprationbuddy.in/labs/css-lab"
      keywords="CSS practice lab, CSS flexbox grid exercises, interactive CSS learning, CSS coding challenges"
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Labs', url: '/labs' }, { name: 'CSS Interactive Labs', url: '/labs/css-lab' }]}
    />
  </head>
  <body>
    <AppNav activeSection="css-lab" client:load />
    <CSSLabsPlatform client:only="react" />
  </body>
</html>