---
import MongoLabsPlatform from '../../components/labs/MongoLabsPlatform.jsx';
import AppNav from '../../components/AppNav.jsx';
import '../../styles/landing.css';
import '../../styles/practice-labs.css';
import '../../styles/lab-base.css';
import '../../styles/mongodb-labs.css';
import PageSEO from '../../components/PageSEO.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="MongoDB Interactive Labs — Interview Prep Buddy"
      description="Practice MongoDB with interactive labs. Work with documents, collections, queries, aggregation pipelines, and indexing in a browser-based environment."
      url="https://interviewpreprationbuddy.in/labs/mongodb-lab"
      keywords="MongoDB practice lab, MongoDB exercises, interactive MongoDB learning, NoSQL practice"
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Labs', url: '/labs' }, { name: 'MongoDB Interactive Labs', url: '/labs/mongodb-lab' }]}
    />
  </head>
  <body>
    <AppNav activeSection="labs" client:load />
    <MongoLabsPlatform client:only="react" />
  </body>
</html>