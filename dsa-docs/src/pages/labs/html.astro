---
import HTMLLanding from '../../components/labs/HTMLLanding.jsx';
import AppNav from '../../components/AppNav.jsx';
import '../../styles/landing.css';
import '../../styles/practice-labs.css';
import PageSEO from '../../components/PageSEO.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="HTML Reference Labs — Interview Prep Buddy"
      description="Interactive HTML reference with live examples covering all HTML5 elements, attributes, forms, semantic markup, and accessibility."
      url="https://interviewpreprationbuddy.in/labs/html"
      keywords="HTML reference interactive, HTML examples live, learn HTML online"
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Labs', url: '/labs' }, { name: 'HTML Reference Labs', url: '/labs/html' }]}
    />
  </head>
  <body>
    <AppNav activeSection="html-lab" client:load />
    <HTMLLanding client:load />
  </body>
</html>