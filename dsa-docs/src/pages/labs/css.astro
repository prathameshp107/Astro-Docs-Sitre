---
import CSSLanding from '../../components/labs/CSSLanding.jsx';
import AppNav from '../../components/AppNav.jsx';
import '../../styles/landing.css';
import '../../styles/practice-labs.css';
import PageSEO from '../../components/PageSEO.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="CSS Reference Labs — Interview Prep Buddy"
      description="Interactive CSS reference with live examples for selectors, properties, flexbox, grid, animations, and modern CSS features."
      url="https://interviewpreprationbuddy.in/labs/css"
      keywords="CSS reference interactive, CSS examples live, learn CSS online"
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Labs', url: '/labs' }, { name: 'CSS Reference Labs', url: '/labs/css' }]}
    />
  </head>
  <body>
    <AppNav activeSection="css-lab" client:load />
    <CSSLanding client:load />
  </body>
</html>