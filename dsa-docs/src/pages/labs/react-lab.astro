---
import ReactLabsPlatform from '../../components/labs/react/ReactLabsPlatform.jsx';
import AppNav from '../../components/AppNav.jsx';
import '../../styles/landing.css';
import '../../styles/practice-labs.css';
import '../../styles/lab-base.css';
import PageSEO from '../../components/PageSEO.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="React Interactive Labs — Interview Prep Buddy"
      description="Learn React with hands-on interactive labs. Practice components, hooks, state management, and React patterns with live preview."
      url="https://interviewpreprationbuddy.in/labs/react-lab"
      keywords="React practice lab, React hooks exercises, interactive React learning, React coding challenges"
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Labs', url: '/labs' }, { name: 'React Interactive Labs', url: '/labs/react-lab' }]}
    />
  </head>
  <body>
    <AppNav activeSection="labs" client:load />
    <ReactLabsPlatform client:only="react" />
  </body>
</html>