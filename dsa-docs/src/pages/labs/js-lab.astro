---
import JSLabsPlatform from '../../components/labs/javascript/JSLabsPlatform.jsx';
import AppNav from '../../components/AppNav.jsx';
import '../../styles/landing.css';
import '../../styles/practice-labs.css';
import '../../styles/lab-base.css';
import PageSEO from '../../components/PageSEO.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="JavaScript Interactive Labs — Interview Prep Buddy"
      description="Practice JavaScript with guided lessons, coding challenges, bug-fixing exercises, and mini projects in an interactive browser-based environment."
      url="https://interviewpreprationbuddy.in/labs/js-lab"
      keywords="JavaScript practice lab, interactive JavaScript exercises, JS coding challenges online, JavaScript learning platform"
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Labs', url: '/labs' }, { name: 'JavaScript Interactive Labs', url: '/labs/js-lab' }]}
    />
  </head>
  <body>
    <AppNav activeSection="labs" client:load />
    <JSLabsPlatform client:only="react" />
  </body>
</html>