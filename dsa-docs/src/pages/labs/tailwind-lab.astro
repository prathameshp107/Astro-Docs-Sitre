---
import TailwindLabsPlatform from '../../components/labs/TailwindLabsPlatform.jsx';
import AppNav from '../../components/AppNav.jsx';
import '../../styles/landing.css';
import '../../styles/practice-labs.css';
import '../../styles/lab-base.css';
import PageSEO from '../../components/PageSEO.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="Tailwind CSS Interactive Labs — Interview Prep Buddy"
      description="Learn Tailwind CSS with interactive labs. Practice utility classes, responsive design, dark mode, and component styling with live preview."
      url="https://interviewpreprationbuddy.in/labs/tailwind-lab"
      keywords="Tailwind CSS practice, Tailwind exercises, interactive Tailwind learning, utility CSS lab"
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Labs', url: '/labs' }, { name: 'Tailwind CSS Interactive Labs', url: '/labs/tailwind-lab' }]}
    />
  </head>
  <body>
    <AppNav activeSection="tailwind-lab" client:load />
    <TailwindLabsPlatform client:only="react" />
  </body>
</html>