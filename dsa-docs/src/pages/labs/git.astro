---
import GitLanding from '../../components/labs/GitLanding.jsx';
import AppNav from '../../components/AppNav.jsx';
import '../../styles/landing.css';
import '../../styles/practice-labs.css';
import PageSEO from '../../components/PageSEO.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="Git Reference Labs — Interview Prep Buddy"
      description="Interactive Git reference with command examples, branching strategies, and version control best practices for developers."
      url="https://interviewpreprationbuddy.in/labs/git"
      keywords="Git reference interactive, Git commands guide, learn Git online"
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Labs', url: '/labs' }, { name: 'Git Reference Labs', url: '/labs/git' }]}
    />
  </head>
  <body>
    <AppNav activeSection="git-lab" client:load />
    <GitLanding client:load />
  </body>
</html>