---
import DSAVisualizerHub from '../components/DSAVisualizerHub.jsx';
import AppNav from '../components/AppNav.jsx';
import PageSEO from '../components/PageSEO.astro';
import '../styles/mcq-tailwind.css';
import '../styles/landing.css';
import '../styles/sketch-visualizer.css';

const SITE_URL = 'https://interviewpreprationbuddy.in';
const PAGE_URL = `${SITE_URL}/visualizer/`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'DSA Algorithm Visualizer — Interactive Step-by-Step Animations',
  description: 'Free interactive algorithm visualizer for data structures and algorithms. Visualize sorting, trees, graphs, binary search, linked lists, stacks, queues, heaps, and more with step-by-step animations.',
  url: PAGE_URL,
  image: `${SITE_URL}/assets/og-image.png`,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  featureList: [
    'Sorting algorithm visualizer (Bubble, Merge, Quick, Insertion, Selection)',
    'Binary tree and BST visualizer',
    'Graph BFS and DFS visualizer',
    'Binary search step-by-step animation',
    'Linked list visualizer',
    'Stack and Queue visualizer',
    'Heap and Priority Queue visualizer',
    'Dynamic programming visualizer',
    'Recursion call stack visualizer',
    'Two pointers and Sliding window visualizer',
    'Backtracking visualizer',
    'Hash table collision resolution visualizer',
    'Trie (Prefix Tree) visualizer with character-by-character insertion and autocomplete',
  ],
  author: { '@id': `${SITE_URL}/#author` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  isPartOf: { '@type': 'WebSite', '@id': `${SITE_URL}/#website` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the best free algorithm visualizer?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Interview Prep Buddy\'s DSA Visualizer is a free, browser-based algorithm visualizer covering 17+ topics including sorting algorithms (Bubble Sort, Merge Sort, Quick Sort), Binary Trees, Graphs (BFS/DFS), Binary Search, Linked Lists, Stacks, Queues, Heaps, Dynamic Programming, Recursion, Two Pointers, Sliding Window, and Backtracking — all with interactive step-by-step animations.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does sorting algorithm visualization work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'In a sorting algorithm visualizer, array elements are displayed as bars of varying heights. At each step, the algorithm compares and swaps elements, which is shown as color-highlighted bars moving in real time. You can control the speed and step through the animation manually to understand how algorithms like Bubble Sort, Merge Sort, and Quick Sort work internally.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which data structures can I visualize?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Interview Prep Buddy visualizes: Arrays, Linked Lists (singly/doubly), Binary Trees, Binary Search Trees, Graphs (directed/undirected), Stacks, Queues, Priority Queues (Heaps), and Hash Tables. Each visualization includes insertion, deletion, and traversal animations.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use the algorithm visualizer to learn for coding interviews?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The algorithm visualizer is specifically designed for coding interview preparation. Seeing algorithms animated step-by-step builds deep intuition that helps you implement them from memory during interviews. Each visualizer includes the algorithm\'s time complexity (Big-O notation), space complexity, and best/worst/average case analysis.',
      },
    },
  ],
};

// Full internal link hub for PageRank distribution and crawlability
const visualizerTopics = [
  { id: 'sorting',       name: 'Sorting Algorithms',          desc: 'Bubble, Merge, Quick, Insertion, Selection Sort' },
  { id: 'trees',         name: 'Binary Trees & BST',          desc: 'BST insertion, deletion, BFS, DFS traversals' },
  { id: 'graphs',        name: 'Graph Algorithms',            desc: 'BFS, DFS, Dijkstra shortest path' },
  { id: 'searching',     name: 'Search Algorithms',           desc: 'Binary Search, Linear Search' },
  { id: 'linked-list',   name: 'Linked Lists',                desc: 'Singly, doubly, reversal, cycle detection' },
  { id: 'stack',         name: 'Stack',                       desc: 'Push, pop, LIFO operations' },
  { id: 'queue',         name: 'Queue',                       desc: 'Enqueue, dequeue, circular queue' },
  { id: 'heaps',         name: 'Heaps & Priority Queues',     desc: 'Min-heap, max-heap, heapify' },
  { id: 'hash-table',    name: 'Hash Tables',                 desc: 'Hash function, chaining, open addressing' },
  { id: 'recursion',     name: 'Recursion',                   desc: 'Call stack, factorial, fibonacci' },
  { id: 'two-pointers',  name: 'Two Pointers',                desc: 'Pair sum, palindrome, sliding technique' },
  { id: 'sliding-window','name': 'Sliding Window',            desc: 'Max sum subarray, longest substring' },
  { id: 'backtracking',  name: 'Backtracking',                desc: 'N-Queens, permutations, Sudoku solver' },
  { id: 'dp',            name: 'Dynamic Programming',         desc: 'Memoization, tabulation, knapsack' },
  { id: 'arrays',        name: 'Arrays',                      desc: 'Insertion, deletion, traversal, and the cost of shifting in contiguous memory' },
  { id: 'trie',          name: 'Trie (Prefix Tree)',           desc: 'Character-by-character insertion, prefix search, and autocomplete' },
  { id: 'dijkstra',      name: "Dijkstra's Shortest Path",    desc: 'Priority queue relaxation on weighted graphs' },
  { id: 'bubble-sort',   name: 'Bubble Sort Step-by-Step',    desc: 'Adjacent comparisons and animated swaps' },
  { id: 'knapsack',      name: '0/1 Knapsack DP Matrix',      desc: 'Cell-by-cell table filling and optimal traceback' },
  { id: 'compare',       name: 'Algorithm Race & Comparison', desc: 'Side-by-side benchmark: Bubble Sort vs Merge Sort' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="DSA Algorithm Visualizer — Interactive Step-by-Step Animations | Interview Prep Buddy"
      description="Free interactive visualizer for 17+ data structures and algorithms. Step-by-step animations for sorting, trees, graphs, binary search, linked lists, stacks, queues, heaps, dynamic programming, recursion, and more."
      url={PAGE_URL}
      keywords="DSA visualizer, algorithm visualizer, sorting algorithm animation, binary tree visualization, graph BFS DFS visualizer, bubble sort animation, merge sort visualizer, binary search visualizer, data structures animation, interactive algorithm learning, free algorithm visualizer"
      schema={schema}
      faqSchema={faqSchema}
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Algorithm Visualizer', url: '/visualizer' }]}
      fontUrl="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&family=Patrick+Hand&family=Caveat&family=Architects+Daughter&display=swap"
    />
  </head>
  <body class="mcq-body">

    <AppNav activeSection="visualizer" client:load />

    <!--
      Static SSR navigation grid — serves two audiences simultaneously:
      1. Google: real crawlable HTML with topic names, descriptions, and links
         shipped at build time (before any JS runs). Without this the page body
         had near-zero indexable text because DSAVisualizerHub is client:load.
      2. Users with JS disabled or slow connections: a full topic index that
         works before React hydrates.
      The grid is styled inline so it doesn't depend on the mcq-tailwind bundle.
    -->
    <nav
      aria-label="All Algorithm Visualizer Topics"
      style="max-width:1100px;margin:0 auto;padding:1.5rem 1rem 0;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.75rem;"
    >
      <h2 style="grid-column:1/-1;font-size:1rem;font-weight:700;color:var(--sl-color-text,#e2e8f0);margin:0 0 0.25rem;letter-spacing:0.05em;text-transform:uppercase;opacity:0.6;">
        Quick Navigate — All Visualizers
      </h2>
      {visualizerTopics.map((t) => (
        <a
          href={`/visualizer/${t.id}/`}
          style="display:block;padding:0.75rem 1rem;border-radius:0.75rem;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);text-decoration:none;transition:border-color 0.2s,background 0.2s;"
          onmouseover="this.style.borderColor='rgba(245,158,11,0.5)';this.style.background='rgba(245,158,11,0.06)'"
          onmouseout="this.style.borderColor='rgba(255,255,255,0.08)';this.style.background='rgba(255,255,255,0.03)'"
        >
          <span style="display:block;font-weight:600;font-size:0.85rem;color:var(--sl-color-text,#e2e8f0);margin-bottom:0.2rem;">{t.name}</span>
          <span style="display:block;font-size:0.72rem;color:var(--sl-color-text-accent,#94a3b8);line-height:1.4;">{t.desc}</span>
        </a>
      ))}
    </nav>

    <!-- Interactive hub — handles search, featured cards, and full topic UI -->
    <DSAVisualizerHub client:load />
  </body>
</html>
