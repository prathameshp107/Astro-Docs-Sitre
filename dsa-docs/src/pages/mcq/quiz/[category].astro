---
import MCQQuiz from '../../../components/mcq/MCQQuiz.jsx';
import AppNav from '../../../components/AppNav.jsx';
import PageSEO from '../../../components/PageSEO.astro';
import '../../../styles/mcq-tailwind.css';
import '../../../styles/landing.css';
import { MCQ_CATEGORIES } from '../../../components/mcq/MCQData.js';

export function getStaticPaths() {
  return MCQ_CATEGORIES.map(cat => ({
    params: { category: cat.id },
  }));
}

const { category } = Astro.params;
const cat = MCQ_CATEGORIES.find(c => c.id === category);
const siteUrl = 'https://interviewpreprationbuddy.in';
const pageUrl = `${siteUrl}/mcq/quiz/${category}/`;
const pageTitle = `${cat.name} MCQ Quiz — Practice Interview Questions | Interview Prep Buddy`;
const pageDescription = `Practice ${cat.name} interview questions in a free interactive MCQ quiz. Get instant explanations, review your answers, and track your progress.`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `${cat.name} MCQ Quiz`,
  description: pageDescription,
  url: pageUrl,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title={pageTitle}
      description={pageDescription}
      url={pageUrl}
      schema={schema}
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'MCQ quizzes', url: '/mcq/' }, { name: `${cat.name} quiz`, url: `/mcq/quiz/${category}/` }]}
      fontUrl="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="mcq-body">
    <AppNav activeSection="mcq" client:load />
    <!-- categoryId only — topic/mode are read client-side from URL params -->
    <MCQQuiz client:load categoryId={category} />
  </body>
</html>
