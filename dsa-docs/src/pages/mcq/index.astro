---
import MCQHub from '../../components/mcq/MCQHub.jsx';
import AppNav from '../../components/AppNav.jsx';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import '../../styles/mcq-tailwind.css';
import '../../styles/landing.css';

const SITE_URL  = 'https://interviewpreprationbuddy.in';
const SITE_NAME = 'Interview Prep Buddy';
const OG_IMAGE  = `${SITE_URL}/assets/og-image.png`;
const PAGE_URL  = `${SITE_URL}/mcq`;
const PAGE_TITLE = 'MCQ Quiz Hub — JavaScript, React, DSA & More Practice Tests | Interview Prep Buddy';
const PAGE_DESC  = 'Test your knowledge with interactive MCQ quizzes across JavaScript, React, Next.js, Node.js, TypeScript, DSA, SQL, Python, and more. Track your score and identify weak areas before your interview.';

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Interview Prep Buddy — MCQ Quiz Hub',
  description: PAGE_DESC,
  url: PAGE_URL,
  image: OG_IMAGE,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  featureList: [
    'JavaScript MCQ quiz', 'React interview MCQ', 'DSA multiple choice questions',
    'Node.js quiz', 'TypeScript quiz', 'SQL quiz', 'Python MCQ', 'Progress tracking',
  ],
  author: { '@id': `${SITE_URL}/#author` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  isPartOf: { '@type': 'WebSite', '@id': `${SITE_URL}/#website` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What MCQ topics are available for interview preparation?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Interview Prep Buddy MCQ Hub covers: JavaScript, React, Next.js, Node.js, TypeScript, HTML/CSS, DSA (Data Structures & Algorithms), SQL, Python, MongoDB, Docker, and more — with questions graded by difficulty from easy to hard.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are these MCQ questions asked in real interviews?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The MCQ questions in Interview Prep Buddy are curated from real technical interviews at FAANG, product companies, and startups. They focus on concepts that interviewers commonly test including closures, event loop, React hooks, tree traversals, and SQL joins.',
      },
    },
    {
      '@type': 'Question',
      name: 'How many MCQ questions are available?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Interview Prep Buddy provides hundreds of MCQ questions across 15+ categories including JavaScript, React, TypeScript, Node.js, DSA, SQL, Python, MongoDB, Docker, and more. New questions are added regularly.',
      },
    },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
    { '@type': 'ListItem', position: 2, name: 'MCQ Quiz Hub', item: PAGE_URL },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <GoogleAnalytics />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{PAGE_TITLE}</title>
    <meta name="description" content={PAGE_DESC} />
    <link rel="canonical" href={PAGE_URL} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content="Prathamesh Pawar" />
    <meta name="keywords" content="JavaScript MCQ, React MCQ quiz, DSA multiple choice questions, programming quiz interview prep, coding interview MCQ, technical quiz online, JavaScript interview quiz, React hooks quiz" />

    <meta property="og:type"         content="website" />
    <meta property="og:title"        content={PAGE_TITLE} />
    <meta property="og:description"  content={PAGE_DESC} />
    <meta property="og:url"          content={PAGE_URL} />
    <meta property="og:image"        content={OG_IMAGE} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name"    content={SITE_NAME} />
    <meta property="og:locale"       content="en_IN" />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={PAGE_TITLE} />
    <meta name="twitter:description" content={PAGE_DESC} />
    <meta name="twitter:image"       content={OG_IMAGE} />

    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="mcq-body">
    <!-- Crawler-visible answer content -->
    <div style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;" aria-hidden="true">
      <h1>MCQ Quiz Hub — Interactive Programming Quizzes for Interview Preparation</h1>
      <p>Practice hundreds of multiple-choice questions across JavaScript, React, Node.js, TypeScript, DSA, SQL, Python, and more. Each quiz tracks your progress and helps identify weak areas before your technical interview.</p>
    </div>
    <AppNav activeSection="mcq" client:load />
    <MCQHub client:load />
  </body>
</html>
