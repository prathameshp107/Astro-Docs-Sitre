---
import LandingPage from '../components/landing/LandingPage.tsx';
import '../styles/dev-ace-landing.css';

const SITE_URL  = 'https://interviewpreprationbuddy.in';
const SITE_NAME = 'Interview Prep Buddy';
const OG_IMAGE  = `${SITE_URL}/assets/og-image.png`;
const PAGE_TITLE = 'Interview Prep Buddy — DSA, System Design & Interview Preparation';
const PAGE_DESC  = 'Master DSA patterns, system design, JavaScript, and React with interactive labs, algorithm visualizers, MCQ rounds, and company-specific interview guides — all in one place.';

// ── WebSite + SearchAction ─────────────────────────────────────────────────
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: SITE_NAME,
  url: SITE_URL,
  description: PAGE_DESC,
  inLanguage: 'en-IN',
  author: { '@id': `${SITE_URL}/#author` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${SITE_URL}/?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};

// ── SiteLinksSearchBox ─────────────────────────────────────────────────────
const searchBoxSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  url: SITE_URL + '/',
  potentialAction: [{
    '@type': 'SearchAction',
    target: `${SITE_URL}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  }],
};

// ── Organisation entity ────────────────────────────────────────────────────
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: SITE_NAME,
  url: SITE_URL,
  logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon.svg`, width: 512, height: 512 },
  image: OG_IMAGE,
  description: 'The all-in-one interview preparation platform for DSA, System Design, JavaScript, React, and company-specific technical interview prep.',
  foundingDate: '2024',
  inLanguage: 'en-IN',
  sameAs: ['https://github.com/prathameshp107/DSA-Notes-Problems'],
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', url: `${SITE_URL}/contact` },
};

// ── Person (Author) entity ─────────────────────────────────────────────────
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#author`,
  name: 'Prathamesh Pawar',
  url: `${SITE_URL}/about`,
  jobTitle: 'Software Developer',
  description: 'Full-stack developer and creator of Interview Prep Buddy.',
  sameAs: ['https://github.com/prathameshp107'],
  worksFor: { '@id': `${SITE_URL}/#organization` },
};

// ── FAQPage for AEO citations ─────────────────────────────────────────────
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is Interview Prep Buddy?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Interview Prep Buddy is a free all-in-one technical interview preparation platform covering DSA, System Design, JavaScript, React, Node.js, and more. It includes interactive labs, algorithm visualizers, MCQ quizzes, 1400+ interview questions, and company-specific guides for FAANG and top tech companies.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I prepare for a coding interview?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'To prepare for a coding interview: 1) Master the 16 core DSA patterns (Two Pointers, Sliding Window, Binary Search, Dynamic Programming, etc.), 2) Practice LeetCode problems by topic and difficulty, 3) Study system design concepts (HLD and LLD), 4) Review language-specific questions (JavaScript, React, Python), 5) Practice behavioral questions using STAR method.',
      },
    },
    {
      '@type': 'Question',
      name: 'What DSA topics should I study for FAANG interviews?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For FAANG interviews, focus on: Arrays & Strings, Linked Lists, Trees & Graphs, Dynamic Programming, Binary Search, Recursion & Backtracking, Sorting algorithms, Heaps/Priority Queues, Hash Maps, and Two Pointers. Master the 16 algorithmic patterns that cover 90% of interview problems.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is Interview Prep Buddy free?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, Interview Prep Buddy is completely free. It provides DSA pattern cheatsheets, algorithm visualizers, interactive coding labs, MCQ practice rounds, 1400+ interview questions, and system design notes — all at no cost.',
      },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function() {
        var t = localStorage.getItem('ipd-theme') || localStorage.getItem('starlight-theme');
        if (t === 'light') document.documentElement.classList.remove('dark');
        else document.documentElement.classList.add('dark');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{PAGE_TITLE}</title>
    <meta name="description" content={PAGE_DESC} />
    <link rel="canonical" href={SITE_URL + '/'} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content="Prathamesh Pawar" />
    <meta name="keywords" content="DSA interview preparation, data structures algorithms, system design interview, JavaScript interview questions, React interview prep, LeetCode patterns, coding interview, technical interview guide, algorithm visualizer, FAANG interview prep" />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={PAGE_TITLE} />
    <meta property="og:description" content={PAGE_DESC} />
    <meta property="og:url"         content={SITE_URL + '/'} />
    <meta property="og:image"       content={OG_IMAGE} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name"   content={SITE_NAME} />
    <meta property="og:locale"      content="en_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={PAGE_TITLE} />
    <meta name="twitter:description" content={PAGE_DESC} />
    <meta name="twitter:image"       content={OG_IMAGE} />

    <!-- JSON-LD: Organization Entity -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <!-- JSON-LD: Person/Author Entity -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <!-- JSON-LD: WebSite + SearchAction -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <!-- JSON-LD: SiteLinksSearchBox -->
    <script type="application/ld+json" set:html={JSON.stringify(searchBoxSchema)} />
    <!-- JSON-LD: FAQPage (AEO citations) -->
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Fonts -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@1,400;1,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Static content for crawlers: hidden visually, indexed by Googlebot & AI engines -->
    <div style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;" aria-hidden="true">
      <h1>Interview Prep Buddy — Complete Interview Preparation Platform</h1>
      <p>Interview Prep Buddy is a free, all-in-one technical interview preparation platform for software engineers. It covers DSA patterns, system design, JavaScript, React, and company-specific guides for FAANG and top tech companies.</p>
      <h2>What is Interview Prep Buddy?</h2>
      <p>Interview Prep Buddy helps developers prepare for technical interviews at Google, Amazon, Meta, Microsoft, Apple and other top tech companies. It provides structured learning paths, interactive tools, and comprehensive question banks across all key interview topics.</p>
      <h2>Features</h2>
      <ul>
        <li>16 Core DSA Patterns with code blueprints (Two Pointers, Sliding Window, Binary Search, Dynamic Programming)</li>
        <li>Interactive Algorithm Visualizer for sorting algorithms, trees, graphs, and binary search</li>
        <li>1400+ Interview Questions covering JavaScript, React, Node.js, Python, CSS, HTML, SQL, MongoDB</li>
        <li>Interactive Coding Labs with live code execution for JavaScript, React, and DSA problems</li>
        <li>MCQ Practice Rounds for self-assessment across 15+ topics</li>
        <li>System Design Guide covering HLD, LLD, databases, caching, and microservices</li>
        <li>Company-Specific Interview Prep for FAANG and product companies</li>
        <li>Behavioral Interview Preparation using STAR method</li>
      </ul>
      <h2>How to prepare for a coding interview?</h2>
      <p>Master the 16 core DSA patterns, practice problems by topic and company, study system design concepts, and review language-specific interview questions. Interview Prep Buddy provides all of these resources in one integrated platform.</p>
    </div>
    <LandingPage client:only="react" />
  </body>
</html>
