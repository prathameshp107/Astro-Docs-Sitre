---
import ReactLanding from '../components/ReactLanding.jsx';
import AppNav from '../components/AppNav.jsx';
import '../styles/landing.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DSA & Dev Notes</title>
    <meta name="description" content="Comprehensive learning hub for DSA, JavaScript, React, Angular, Next.js, Node.js, MongoDB, MySQL, Docker, Python, Redis, and interview preparation." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <AppNav activeSection="home" client:load />
    <ReactLanding client:load />
  </body>
</html>
