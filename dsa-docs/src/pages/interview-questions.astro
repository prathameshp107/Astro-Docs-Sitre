---
import InterviewQuestionHub from '../components/interview/InterviewQuestionHub.jsx';
import AppNav from '../components/AppNav.jsx';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { TABS, TOTAL_QUESTIONS } from '../data/interview-questions-data.js';
import '../styles/mcq-tailwind.css';
import '../styles/landing.css';

const SITE_URL = 'https://interviewpreprationbuddy.in';
const SITE_NAME = 'Interview Prep Buddy';
const OG_IMAGE = `${SITE_URL}/assets/og-image.png`;
const PAGE_URL = `${SITE_URL}/interview-questions/`;
const PAGE_TITLE = `${TOTAL_QUESTIONS}+ Technical Interview Questions & Answers | Prep Buddy`;
const PAGE_DESC = `Master ${TOTAL_QUESTIONS}+ verified technical interview questions with comprehensive answers across AI, LLM, RAG Architecture, JavaScript, React, Next.js, DSA & System Design. Interactive practice studio.`;

// Curated high-frequency question samples across primary domains for search engine Q&A extraction
const featuredQuestions = TABS.slice(0, 10).map((tab) => ({
  '@type': 'Question',
  name: tab.questions[0][0],
  eduQuestionType: 'Flashcard',
  acceptedAnswer: {
    '@type': 'Answer',
    text: tab.questions[0][2]?.slice(0, 350) + (tab.questions[0][2]?.length > 350 ? '...' : '') || 'Comprehensive technical interview answer.',
  },
}));

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      description: 'Comprehensive DSA, System Design, AI and Technical Interview Preparation Platform',
      inLanguage: 'en-US',
    },
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: SITE_URL,
      logo: {
        '@type': 'ImageObject',
        url: OG_IMAGE,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${PAGE_URL}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${SITE_URL}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Interview Questions Studio',
          item: PAGE_URL,
        },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${PAGE_URL}#webpage`,
      url: PAGE_URL,
      name: PAGE_TITLE,
      description: PAGE_DESC,
      isPartOf: { '@id': `${SITE_URL}/#website` },
      breadcrumb: { '@id': `${PAGE_URL}#breadcrumb` },
      inLanguage: 'en-US',
      datePublished: '2024-01-15T08:00:00+00:00',
      dateModified: '2026-09-05T12:00:00+00:00',
      about: [
        { '@type': 'Thing', name: 'Artificial Intelligence' },
        { '@type': 'Thing', name: 'Large Language Models' },
        { '@type': 'Thing', name: 'Retrieval-Augmented Generation' },
        { '@type': 'Thing', name: 'JavaScript Programming' },
        { '@type': 'Thing', name: 'React Framework' },
        { '@type': 'Thing', name: 'Data Structures and Algorithms' },
        { '@type': 'Thing', name: 'System Design' },
        { '@type': 'Thing', name: 'Software Engineering Interviews' },
      ],
      mainEntity: featuredQuestions,
    },
    {
      '@type': 'LearningResource',
      '@id': `${PAGE_URL}#learning-resource`,
      name: 'Full Stack & AI Technical Interview Mastery Deck',
      description: PAGE_DESC,
      educationalLevel: 'Intermediate to Advanced',
      learningResourceType: 'Practice Problem / Quiz',
      assesses: [
        'AI / ML Architecture',
        'Large Language Model Internals & Attention Mechanics',
        'Retrieval-Augmented Generation (RAG) Pipelines',
        'JavaScript & TypeScript Core Execution',
        'Frontend Architecture (React, Next.js, Angular)',
        'Backend Systems (Node.js, Python, Databases)',
        'Data Structures and Algorithmic Problem Solving',
      ],
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <GoogleAnalytics />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO Meta Tags -->
    <title>{PAGE_TITLE}</title>
    <meta name="description" content={PAGE_DESC} />
    <link rel="canonical" href={PAGE_URL} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="keywords" content="AI interview questions, LLM interview questions, RAG architecture, JavaScript interview questions, Tricky JS code outputs, React interview questions, Next.js interview, DSA interview questions, Node.js interview, coding interview prep, technical interview questions 2026, software engineer interview prep" />
    <meta name="author" content="Prathamesh Pawar" />
    <meta name="theme-color" content="#121110" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={PAGE_TITLE} />
    <meta property="og:description" content={PAGE_DESC} />
    <meta property="og:url" content={PAGE_URL} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:alt" content="Technical Interview Preparation Studio - AI, LLM, RAG, JS, React & DSA" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={PAGE_TITLE} />
    <meta name="twitter:description" content={PAGE_DESC} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content="Technical Interview Preparation Studio - AI, LLM, RAG, JS, React & DSA" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="mcq-body">
    <AppNav activeSection="interview-questions" client:load />

    <!-- Main Interactive Studio -->
    <InterviewQuestionHub client:load />

    <!-- Accessible Semantic SEO Fallback for Search Crawlers & Non-JS Clients -->
    <noscript>
      <section class="seo-crawler-index max-w-5xl mx-auto p-8 my-8 bg-zinc-950 text-zinc-100 rounded-2xl border border-zinc-800">
        <h2 class="text-2xl font-bold mb-4">Complete Technical Interview Questions Index ({TOTAL_QUESTIONS}+ Questions across {TABS.length} Categories)</h2>
        <p class="text-zinc-400 mb-6">
          Browse comprehensive technical interview questions with deep answers for frontend, backend, AI/ML, and system design interviews.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {TABS.map((tab) => (
            <div class="p-4 rounded-xl bg-zinc-900 border border-zinc-800">
              <h3 class="font-bold text-amber-400 text-lg mb-1">
                <a href={`/interview-questions?tab=${tab.id}`} class="hover:underline">
                  {tab.label} ({tab.questions.length} Questions)
                </a>
              </h3>
              <p class="text-xs text-zinc-400">
                Sample Question: {tab.questions[0][0]}
              </p>
            </div>
          ))}
        </div>
      </section>
    </noscript>
  </body>
</html>
