---
import AppNav from '../../components/AppNav.jsx';
import PlanGallery from '../../components/plans/PlanGallery.jsx';
import PageSEO from '../../components/PageSEO.astro';
import '../../styles/landing.css';
import '../../styles/plans.css';
import '../../styles/sketch-visualizer.css';

const { getPlanManifest, getPlans } = await import('../../data/plans/index.js');
const plans = getPlans();
const manifest = getPlanManifest();

const SITE_URL = 'https://interviewpreprationbuddy.in';
const PAGE_URL = `${SITE_URL}/plans/`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(){var t=localStorage.getItem('starlight-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark');})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageSEO
      title="Study Plans — Structured DSA & Interview Prep Roadmaps | Interview Prep Buddy"
      description="Structured day-by-day study plans for DSA, JavaScript, React, SQL, and interview preparation. Start a guided plan and get daily tasks with interactive progress tracking."
      url={PAGE_URL}
      keywords="DSA study plan, interview prep roadmap, coding interview plan, JavaScript study plan, structured learning path, day by day interview preparation"
      breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Study Plans', url: '/plans' }]}
    />
  </head>
  <body class="plan-page font-sketch">
    <AppNav activeSection="plans" client:load />
    
    <div class="max-w-6xl mx-auto px-4 py-8">
      <!-- Chalkboard Hero Section -->
      <header class="sketch-border bg-[var(--sketch-bg-dim)] p-8 md:p-10 rounded-3xl text-center mb-10 border-2 border-[var(--sketch-border)] shadow-2xl relative font-sketch">
        <div class="inline-block sketch-border-soft px-4 py-1.5 text-xs font-mono font-bold bg-amber-500/20 text-amber-500 border-amber-500/40 rounded-full mb-4">
          🚀 STRUCTURED LEARNING PATHS
        </div>
        <h1 class="font-header font-bold text-4xl md:text-5xl text-[var(--sketch-text)] mb-4">
          Study Plans Studio
        </h1>
        <p class="text-[var(--sketch-text-muted)] text-base md:text-lg max-w-2xl mx-auto leading-relaxed font-sketch">
          Pick a plan. The site tells you exactly what to do every day with interactive task tracking.
        </p>
      </header>

      <PlanGallery plans={plans} client:only="react" />
    </div>
  </body>
</html>
