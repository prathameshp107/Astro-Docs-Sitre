# Environment Variables for Interview Prep Buddy

# Google Analytics 4 Measurement ID (safe to expose client-side).
# Leave unset to disable GA entirely (dev/local builds work fine without it).
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Feedback Widget Email (FormSubmit)
PUBLIC_FEEDBACK_EMAIL=interviewpreprationbuddy@gmail.com

# Supabase Auth & DB Config
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key