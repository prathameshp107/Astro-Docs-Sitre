{
  "installCommand": "cd dsa-docs && npm install",
  "buildCommand": "cd dsa-docs && npm run build",
  "outputDirectory": "dsa-docs/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net/ https://unpkg.com/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com/; font-src 'self' https://fonts.gstatic.com/; connect-src 'self' https://*.supabase.co https://cdn.jsdelivr.net/ https://unpkg.com/; worker-src 'self' blob:; frame-src 'self' blob: data:;" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/u/:username",
      "destination": "/u/placeholder"
    },
    {
      "source": "/DSA-Notes-Problems/:path*",
      "destination": "/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/visualizer/heap",
      "destination": "/visualizer/heaps",
      "permanent": true
    },
    {
      "source": "/visualizer/hash-tables",
      "destination": "/visualizer/hash-table",
      "permanent": true
    }
  ]
}
