{
  "installCommand": "cd dsa-docs && npm install",
  "buildCommand": "cd dsa-docs && npm run build",
  "outputDirectory": "dsa-docs/dist",
  "rewrites": [
    {
      "source": "/u/:username",
      "destination": "/u/placeholder"
    },
    {
      "source": "/DSA-Notes-Problems/:path*",
      "destination": "/:path*"
    }
  ]
}
